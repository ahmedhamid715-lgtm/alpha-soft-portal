# Alpha OS — environment variables
#
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored — never commit real secrets.
#
# Every variable is documented in src/config/environment.ts (server-only
# values) and src/config/environment.public.ts (NEXT_PUBLIC_* values, which
# ARE exposed to the browser bundle — never put a secret behind that prefix).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Public base URL of this deployment. Safe to expose to the client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Postgres via Prisma, pg driver adapter) — hosted on Supabase
# ---------------------------------------------------------------------------
# Not required to run `npm run dev` — Module 01 boots without a database.
# Required once you start running migrations (Module 03 onward) or want
# /api/health/db to report "healthy" instead of "unavailable".
#
# Get this from your Supabase project: Project Settings → Database →
# Connection string → "URI" (direct connection, port 5432). Use the DIRECT
# connection here, not the "Transaction pooler" (port 6543) one — Prisma
# Migrate needs prepared-statement support that PgBouncer's transaction
# mode doesn't provide. Only switch to the pooled URL (with `?pgbouncer=true`
# appended) if you deploy somewhere with many short-lived serverless
# invocations (e.g. Vercel functions) that would otherwise exhaust
# Postgres's connection limit — see docs/architecture/database.md.
#
# NOTE: put real values in `.env` (not `.env.local`) — the Prisma CLI's
# dotenv loader (used by prisma.config.ts) only reads `.env` by default,
# and Next.js reads both, so `.env` is the one file both tools agree on.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Authentication (Module 04)
# ---------------------------------------------------------------------------
# High-entropy random string used to sign/encrypt the session JWT. Required
# in production — Auth.js throws MissingSecretError without it. Generate one
# with:
#   openssl rand -base64 32
AUTH_SECRET=

# Required in production ONLY if the app runs behind a reverse proxy/hosting
# platform (Vercel, etc.) — Auth.js refuses to trust the incoming Host header
# otherwise (UntrustedHost error), which is correct default behavior, not a
# bug to work around. Not needed for local development.
AUTH_TRUST_HOST=

# ---------------------------------------------------------------------------
# AI (Module 33 — AI Core)
# ---------------------------------------------------------------------------
# Anthropic API key, server-side only — never expose via NEXT_PUBLIC_*.
# Claude is the primary AI provider for Alpha OS.
ANTHROPIC_API_KEY=

# OpenAI — planned secondary provider (decided during Module 01, wired up
# in Module 33). Only OPENAI_API_KEY is required; OPENAI_BASE_URL only if
# routing through an OpenAI-compatible endpoint other than api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_CHAT_MODEL="gpt-4o"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
