// Alpha OS — Prisma schema
//
// Module 01 (Platform Core) established the generator/datasource wiring
// only. Module 03 (Database Architecture) introduces the first real
// models — the "Layer A: Platform" foundation every future business
// module (CRM, Projects, Support, Billing, ...) builds on:
// Organization, User, OrganizationMembership.
//
// Conventions applied throughout (see docs/architecture/database.md and
// docs/architecture/data-modeling.md for the full reasoning, not repeated
// per-field here):
//   - IDs: UUIDv7, generated in application code via generateId()
//     (src/lib/utils/id.ts), stored as native `Uuid`. Never
//     `@default(uuid())` — see database.md for why.
//   - Timestamps: UTC, `@db.Timestamptz(3)`, never bare `timestamp`.
//   - Naming: Prisma-side stays idiomatic camelCase/PascalCase; the actual
//     Postgres table/column names are snake_case via `@@map`/`@map` —
//     see data-modeling.md "Naming conventions."
//   - Deletion: per-entity policy, not applied uniformly — see
//     data-modeling.md "Deletion strategy." Organization is Archivable
//     (never hard/soft-deleted). User is deactivated via `status`, not
//     deleted. OrganizationMembership is hard-deleted (a join row with no
//     independent existence or historical value of its own).
//
// Connection details are NOT set here — Prisma 7 reads them from
// prisma.config.ts at the project root, not from `env("DATABASE_URL")` in
// this file. See docs/architecture/database.md for why.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Organization
// =============================================================================

/// A tenant. Every future business entity (CRM records, projects, tickets,
/// invoices, ...) is scoped to an Organization, directly or transitively.
/// See docs/architecture/tenancy-foundation.md for the full tenancy model
/// this establishes the foundation for (Module 06 implements the rest).
model Organization {
  id String @id @db.Uuid

  /// Legal/business name — may differ from `displayName` (a DBA, a shortened brand name).
  name        String
  displayName String @map("display_name")
  /// URL-safe, unique, immutable-in-practice identifier (subdomains, API paths). Lowercase, hyphenated.
  slug        String @unique

  status OrganizationStatus @default(ACTIVE)

  /// IANA timezone name. Falls back to `config/app.ts`'s `appConfig.defaults.timezone` until Module 06 adds a settings UI.
  timezone String @default("America/New_York")
  /// BCP 47 locale tag.
  locale   String @default("en-US")
  /// ISO 4217 currency code — see src/lib/utils/money.ts for how amounts are stored/converted.
  currency String @default("USD")

  /// Module 07 — organization profile fields, evaluated individually
  /// against the existing schema (spec section 4), not added as a block.
  /// Deliberately NOT added: `legalName` — `name` above is already
  /// documented as the legal/business name; a second field would just
  /// duplicate it. All nullable: none of these are known at organization
  /// creation time (spec section 29's creation transaction only requires
  /// name/displayName/slug), filled in later via profile settings.
  logoUrl      String? @map("logo_url")
  website      String?
  industry     String?
  /// ISO 3166-1 alpha-2 — same convention as `currency`'s ISO 4217.
  country      String?
  phone        String?
  /// The organization's own contact address — distinct from any member's
  /// personal `User.email` (spec section 7's "separate global identity
  /// from membership" applies here too: this is organization data, not
  /// a person's).
  primaryEmail String? @map("primary_email")

  /// Module 05 (RBAC) — resolves the "internal staff vs. customer" open
  /// question `tenancy-foundation.md` deliberately left open in Module 03,
  /// in favor of option 2 there: Alpha Page Rankers is its own seeded
  /// Organization (`isPlatform = true`), and its staff hold PLATFORM-scope
  /// roles via ordinary `OrganizationMembership` rows — no second
  /// membership table, no `User.type` column. At most one row may carry
  /// this flag — enforced by a hand-added partial unique index
  /// (`organizations_single_platform_org`, migration
  /// `20260816120000_platform_org_singleton`), not just service-layer
  /// discipline: this module's own authorization-engine test found that
  /// a second `isPlatform = true` row made `findPlatformOrganization()`'s
  /// `findFirst()` non-deterministically resolve the wrong one, silently
  /// breaking platform-staff authorization. See
  /// docs/architecture/rbac.md "Platform vs. organization scope."
  isPlatform Boolean @default(false) @map("is_platform")

  /// Deliberately flexible bag for settings that don't yet have (or may never need) a dedicated column — see data-modeling.md "JSON/JSONB strategy" for what belongs here vs. a real column.
  metadata Json?

  /// Archive lifecycle only (see data-modeling.md) — an Organization is never hard- or soft-deleted, only archived.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships            OrganizationMembership[]
  /// Custom (organization-scoped) roles this organization has created — see Role below. System roles have `organizationId = null` and aren't reachable through this relation.
  roles                  Role[]
  /// Module 07 — invitations issued by this organization (pending, accepted, or revoked).
  invitations            Invitation[]
  /// Module 07 — this organization's onboarding progress, if it has any (see OrganizationOnboarding).
  onboarding             OrganizationOnboarding?
  /// Module 12 — this organization's invitation governance policy, if it has customized one (see OrganizationInvitationPolicy — lazily created, most organizations have none).
  invitationPolicy       OrganizationInvitationPolicy?
  /// Module 08 — this organization's audit trail. `SetNull`, never
  /// `Cascade` (see tenancy-foundation.md "Audit foundation" — an audit
  /// trail that disappears when the thing it describes is deleted has
  /// failed at its one job — and `AuditEvent.organizationId`'s own
  /// `Restrict` first draft turned out to be the wrong choice too: it
  /// was found, by actually running the test suite (not just source
  /// inspection — Phase 40), to make every org hard-delete anywhere —
  /// including ordinary test fixture cleanup — fail once a single audit
  /// event referenced it. `SetNull` preserves the row and its
  /// `resourceName`/`actorDisplayName` snapshot fields — the actual
  /// evidence — without permanently pinning the organization row in
  /// place.
  auditEvents            AuditEvent[]
  /// Module 09 — notifications associated with this organization
  /// (grouping/filtering/observability only, never the SELECT boundary —
  /// see `docs/architecture/notifications.md` "Notification —
  /// recipient-owned, organization-*associated*"). `SetNull`, same
  /// Module-08-learned reasoning as `auditEvents` above.
  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]
  /// Module 13 — this organization's billing relationship, if it has
  /// one (see BillingAccount — lazily created on first checkout, same
  /// "not every organization has customized/activated this yet" shape
  /// as `invitationPolicy` above). `Subscription`/`Invoice`/`Payment`/
  /// `CreditLedgerEntry` also carry their own direct `organizationId`
  /// (denormalized from `billingAccountId` for RLS/query simplicity —
  /// see billing-data-model.md "Ownership classification"), so each
  /// needs its own reverse-relation array here too.
  billingAccount         BillingAccount?
  subscriptions          Subscription[]
  invoices               Invoice[]
  payments               Payment[]
  creditLedgerEntries    CreditLedgerEntry[]
  /// Module 17 — this organization's AI support-chat conversations.
  /// `Cascade`, same shape as the billing relations above (real,
  /// organization-owned business data — not evidentiary like
  /// `auditEvents`, which stay `SetNull`).
  aiConversations        AiConversation[]
  /// Module 18 — this organization's own knowledge sources/documents
  /// (nullable-`organizationId` platform-level rows are NOT reachable
  /// through this relation, the same shape `roles`' own `organizationId
  /// IS NULL` system rows aren't a `Role[]` on any one `Organization`).
  /// `Cascade`, same reasoning as `aiConversations` above.
  knowledgeSources       KnowledgeSource[]
  knowledgeDocuments     KnowledgeDocument[]

  @@index([status])
  @@index([isPlatform])
  @@map("organizations")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

// =============================================================================
// User
// =============================================================================

/// A person's identity in the system. Deliberately minimal — this is the
/// row Module 04 (Authentication) attaches credentials/sessions to, not
/// the auth system itself. No password, session, or provider-account
/// fields here; adding those is Module 04's job once the auth mechanism
/// (Auth.js vs. custom) is chosen, likely as fields added to this model
/// or a related Account/Session model alongside it (Auth.js's own
/// convention) — either extension is compatible with what's here.
model User {
  id String @id @db.Uuid

  /// Stored lowercase — normalize at the repository boundary, not via a Postgres `citext` extension (see data-modeling.md).
  email String @unique
  name  String

  status UserStatus @default(INVITED)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Set by Module 04 on successful sign-in. Not itself an audit trail — see docs/architecture/tenancy-foundation.md "Audit foundation" for where real login history belongs.
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)

  /// Module 07 — self-service profile fields (spec section 24). All
  /// nullable and fall back to defaults elsewhere (`config/app.ts`'s
  /// `appConfig.defaults`, or the user's organization's own
  /// timezone/locale) when unset — a person's own preference, distinct
  /// from any organization's. Deliberately NOT a generic `preferences`
  /// JSON blob (data-modeling.md's "no giant JSON dumping ground"
  /// discipline applies to User exactly as it does to Organization) —
  /// add a real column when a real preference is justified, the same
  /// rule this file already follows throughout.
  avatarUrl String? @map("avatar_url")
  timezone  String?
  locale    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships                  OrganizationMembership[]
  /// Module 07 — invitations this user has sent (as an org admin/owner) or accepted.
  invitationsSent              Invitation[]             @relation("InvitationsSent")
  invitationsAccepted          Invitation[]             @relation("InvitationsAccepted")
  credential                   UserCredential?
  sessions                     UserSession[]
  authTokens                   AuthToken[]
  /// Module 08 — audit events where this user is the actor. `SetNull`,
  /// same reasoning as `Organization.auditEvents` — never `Cascade`.
  /// Never joined for display (see `AuditEvent.actorDisplayName`); this
  /// relation exists for referential integrity only.
  auditEvents                  AuditEvent[]
  /// Module 09 — notifications addressed to this user. `Cascade`, NOT
  /// `SetNull` like `auditEvents` — deliberately different reasoning,
  /// not an oversight: `recipientUserId` is a required field (a
  /// notification with no recipient is meaningless), and a notification
  /// has no independent evidentiary value once its recipient doesn't
  /// exist (unlike an `AuditEvent`, which IS the record of what
  /// happened regardless of whether the actor account survives). `User`
  /// rows are never hard-deleted in real operation (`data-modeling.md`
  /// "Deletion strategy" — deactivation, not deletion) — this FK choice
  /// matters for test-fixture cleanup ergonomics (the exact class of bug
  /// Module 08 hit with `Restrict`), not for any real production path.
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  /// Module 13 — refunds this platform-staff user personally issued
  /// (never a customer; see billing-security.md "Refunds are staff-
  /// initiated only"). `SetNull` — the refund record itself is the
  /// financial evidence and must survive independent of whether the
  /// staff account does (same reasoning as `auditEvents` above).
  refundsInitiated             Refund[]
  /// Module 14 — credit ledger entries this platform-staff user
  /// personally issued/adjusted. Same `SetNull` reasoning as
  /// `refundsInitiated` above.
  creditLedgerEntriesInitiated CreditLedgerEntry[]
  /// Module 17 — AI support-chat conversations this user has started.
  /// `Cascade` — same "User is never hard-deleted in real operation;
  /// this FK matters for test-fixture cleanup ergonomics, not a real
  /// production path" reasoning as `notifications` above, and a
  /// conversation with no owning user is meaningless (same logic).
  aiConversations              AiConversation[]

  @@index([status])
  @@map("users")
}

enum UserStatus {
  /// Account created (e.g. via an org invite) but no successful sign-in yet.
  INVITED
  ACTIVE
  SUSPENDED
  /// Deliberately not deleted — see data-modeling.md "Deletion strategy."
  DEACTIVATED

  @@map("user_status")
}

// =============================================================================
// OrganizationMembership
// =============================================================================

/// The join between User and Organization — see docs/architecture/tenancy-foundation.md
/// for the full reasoning behind this shape (not `User.organizationId`,
/// which can't represent a user belonging to more than one organization).
model OrganizationMembership {
  id String @id @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  /// Module 04's original role KEY ("owner", "admin", "support", "member") — kept exactly as-is, still authoritative for `resolveDestination()` (Module 04's post-login routing), untouched by Module 05. See `roleId` below for the real RBAC relationship; the two are kept in sync by `roleAssignmentService.assignRole()`, never written independently.
  role   String
  /// Module 05 (RBAC) — the actual `Role` this membership grants, resolving `tenancy-foundation.md`'s "migration path when Module 05 lands": a real foreign key, not a second guess at what `role` (the string) means. Nullable rather than a same-migration NOT NULL, per `migrations.md`'s expand→migrate→contract — every membership this module creates or updates always sets it; existing Module 03/04 rows are backfilled by this module's seed. `onDelete: Restrict` is section 26's "prevent deletion of roles currently assigned to users," enforced by the database, not just application code.
  roleId String?          @map("role_id") @db.Uuid
  status MembershipStatus @default(ACTIVE)

  invitedAt DateTime? @map("invited_at") @db.Timestamptz(3)
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef      Role?        @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// A user has at most one membership per organization — their role changes in place, they don't get a second row.
  @@unique([organizationId, userId])
  /// "Which organizations does this user belong to" — the membership-switcher / org-picker query.
  @@index([userId])
  /// "Who are this organization's active members" — the member-list query.
  @@index([organizationId, status])
  /// The authorization engine's hot path — "what role does this membership have."
  @@index([roleId])
  @@map("organization_memberships")
}

enum MembershipStatus {
  /// Invited but hasn't accepted yet.
  INVITED
  ACTIVE
  /// Access revoked without deleting the historical membership record.
  SUSPENDED

  @@map("membership_status")
}

// =============================================================================
// UserCredential — Module 04 (Authentication)
// =============================================================================

/// A user's password credential, kept in its own 1:1 table rather than
/// columns on `User` — see docs/architecture/authentication.md "Database
/// changes" for why: it keeps the sensitive hash out of the same table as
/// frequently-selected profile data, and leaves room for a user to
/// eventually have other credential types (a future OAuth `Account`
/// table, alongside or instead of this) without `User` accumulating
/// nullable auth-method-specific columns.
model UserCredential {
  id     String @id @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// An Argon2id PHC-formatted hash string (includes algorithm + parameters + salt) — never a raw password, never a bare digest. See authentication.md "Password storage."
  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

// =============================================================================
// UserSession — Module 04 (Authentication)
// =============================================================================

/// This module's OWN session-tracking table — not Auth.js's adapter-managed
/// `Session` model. Auth.js's Credentials provider requires the JWT session
/// strategy (its database strategy throws `UnsupportedStrategy` when
/// combined with Credentials), which by itself provides no server-side
/// revocation. This table is what makes "logout everywhere," "revoke a
/// compromised session," and "invalidate sessions after a password reset"
/// possible anyway — see authentication.md "Session strategy" for the full
/// tradeoff writeup. The JWT carries this row's `id`; every authenticated
/// server-side check looks the row up and honors `revokedAt`/`expiresAt`
/// before trusting the JWT's claims.
model UserSession {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Truncated on write, informational only — not a fingerprinting mechanism. See authentication.md "Session/device foundation."
  userAgent String? @map("user_agent")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Updated at most once per `updateAge` window (see auth.ts) — not on every single request, to avoid a write on every page load.
  lastActiveAt  DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// e.g. "user_logout", "password_reset", "admin_revoked" — for the future session-management UI (not built in this module), not machine logic.
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "This user's sessions" — the future session-management list, and the "revoke everywhere" bulk update.
  @@index([userId])
  /// A future cleanup job's query ("delete sessions past expiry") — not built in this module.
  @@index([expiresAt])
  @@map("user_sessions")
}

// =============================================================================
// AuthToken — Module 04 (Authentication)
// =============================================================================

/// One shape, two purposes — email verification and password reset are
/// both "a single-use, expiring, securely-random token tied to a user."
/// Not Auth.js's adapter-managed `VerificationToken` model (which stores
/// the raw token value); this table stores only a SHA-256 hash of the
/// token, so a database read alone (a backup, a compromised replica)
/// never yields a usable token — see authentication.md "Token storage."
enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_purpose")
}

model AuthToken {
  id      String           @id @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  purpose AuthTokenPurpose

  /// SHA-256 hex digest of the raw token. The raw token is sent to the user's email and never persisted.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set the moment the token is used — a non-null value means "already consumed," enforced in application code before any state-changing effect (verifying the email, resetting the password) happens.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "Does this user already have a live verification/reset token" — checked before issuing a new one.
  @@index([userId, purpose])
  @@map("auth_tokens")
}

// =============================================================================
// Role / Permission / RolePermission — Module 05 (RBAC & Authorization)
// =============================================================================
//
// Implements tenancy-foundation.md's documented "migration path when
// Module 05 lands": a real Role table, keyed by the same string values
// Module 04 already used ("owner", "admin", "support", "member"), plus a
// foreign key from OrganizationMembership to it (`roleId`, added above).
// `OrganizationMembership.role` (the string) is untouched — Module 04's
// destination routing keeps working unmodified — but it is no longer the
// source of truth for *authorization*; `roleId` → Role → RolePermission →
// Permission is. See docs/architecture/rbac.md for the full model.

/// PLATFORM roles operate across Alpha OS itself (assigned only within the
/// one Organization where `isPlatform = true`). ORGANIZATION roles operate
/// within a single tenant organization. A role's scope is fixed at
/// creation — see rbac.md "Platform vs. organization boundaries" for why
/// this must never be inferred from *which* organization a membership
/// happens to be in.
enum RoleScope {
  PLATFORM
  ORGANIZATION

  @@map("role_scope")
}

/// A named, permission-bearing role. System roles (`isSystem = true`,
/// `organizationId = null`) are seeded once (`prisma/seed-rbac.ts`),
/// globally visible, and protected from deletion/renaming by application
/// code (`role-service.ts`) — see rbac.md "System vs. custom roles."
/// Custom roles are organization-scoped (`organizationId` set,
/// `isSystem = false`), created/edited by an organization with
/// `roles.manage`, and can never collide with another organization's
/// custom role of the same `key` (the unique index below is scoped to
/// `organizationId`).
///
/// **NULL-uniqueness note**: Postgres's standard unique index treats two
/// NULLs as distinct, so `@@unique([organizationId, key])` alone would
/// not stop two system roles (`organizationId = null`) from sharing a
/// `key`. A hand-added partial unique index closes that gap — see the
/// migration SQL and `database-schema.md` "Role" for the exact statement
/// this schema depends on but cannot express natively.
model Role {
  id String @id @db.Uuid

  /// Null for a system role (global); set for a custom, organization-scoped role.
  organizationId String? @map("organization_id") @db.Uuid

  /// A slug: "owner", "platform_admin", "custom-billing-lead". Unique within its scope — see the NULL-uniqueness note above.
  key         String
  name        String
  description String?

  scope RoleScope

  /// Protected: cannot be deleted, renamed, or rescoped by `role-service.ts` regardless of the caller's permissions — see rbac.md "System role protection."
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  /// Every membership currently holding this role — `onDelete: Restrict` on the other side of this relation (see OrganizationMembership.roleRef) is what makes deleting an assigned role fail loudly instead of silently orphaning memberships.
  memberships     OrganizationMembership[]
  /// Module 07 — every pending/past invitation offering this role. Same `onDelete: Restrict` protection as `memberships` above — see Invitation's own comment.
  invitations     Invitation[]

  @@unique([organizationId, key])
  @@index([scope])
  @@index([isSystem])
  @@map("roles")
}

/// The permission catalog — see `src/lib/authorization/permissions.ts` for
/// the single TypeScript source of truth this table is seeded from
/// (spec section 9/10: "do not duplicate permission arrays in multiple
/// places" — the seed reads the catalog constant, nothing hand-types rows
/// here twice). `key` is `resource.action` (`"tickets.assign"`); `scope`
/// lets the role-permission assignment service reject an obviously wrong
/// grant (a PLATFORM-only permission on an ORGANIZATION-scope role) at
/// write time instead of only at check time.
model Permission {
  id          String    @id @db.Uuid
  /// `resource.action`, e.g. "users.read", "tickets.assign" — see permissions.ts for the centralized resource/action vocabulary this must be built from.
  key         String    @unique
  resource    String
  action      String
  scope       RoleScope
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  /// "Every permission for this resource" — used when rendering a role-editor grouped by resource.
  @@index([resource])
  @@index([scope])
  @@map("permissions")
}

/// The Role↔Permission grant. Pure join, no independent value once either
/// side is gone — cascade-deleted like `OrganizationMembership`, not
/// archived (see data-modeling.md "Deletion strategy"). A `Role` itself
/// cannot be deleted while assigned to a membership (`Restrict` above),
/// so by the time a Role delete reaches this table, no live grant here
/// still matters to an active user.
model RolePermission {
  id           String @id @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  /// A role has each permission at most once.
  @@unique([roleId, permissionId])
  /// The authorization engine's hot path — "every permission this role grants," read on every `requirePermission()` call (see rbac.md "Permission caching" for why this isn't cached yet).
  @@index([roleId])
  /// "Every role that grants this permission" — used by the role-management UI ("who can do X").
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// Invitation — Module 07 (User & Organization Management)
// =============================================================================

/// A single-use, expiring, hashed-at-rest token offering someone
/// (identified by email, not necessarily an existing `User`) a role in
/// an organization. Deliberately NOT `AuthToken` (Module 04) reused with
/// a new `purpose` value — `AuthToken.userId` is required, but an
/// invitation to someone with no Alpha OS account yet (spec section 14's
/// "email does not belong to existing user" case) has no `User` row to
/// attach to. Same underlying token primitives as `AuthToken`
/// (`lib/auth/tokens.ts`'s `generateRawToken`/`hashToken` — SHA-256, the
/// raw value never persisted, only `tokenHash`), a genuinely different
/// shape of row. See docs/architecture/invitations.md.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@map("invitation_status")
}

model Invitation {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Normalized (see `normalizeEmail()`, reused from Module 04/`user-repository.ts` — one canonical normalization strategy, not a second one). Matched case-insensitively against `User.email` at acceptance.
  email String

  /// The role this invitation offers — validated at issuance (`invitation-service.ts`) to belong to this same organization or be a system role, exactly like `role-service.ts`'s `assignRole()` validates. `onDelete: Restrict` — a role can't be deleted while a pending invitation still offers it (same protection `OrganizationMembership.roleId` already has — see rbac.md "Deletion safety").
  roleId String @map("role_id") @db.Uuid

  /// Who sent it — for display ("invited by Jane") and so `invitation-service.ts` can enforce spec section 16 (an inviter can't offer a role they themselves couldn't grant) using the SAME `requirePermission()`/`assignRole()`-shaped checks role assignment already uses, not a parallel rule.
  invitedByUserId String @map("invited_by_user_id") @db.Uuid

  /// SHA-256 hex digest — see `AuthToken.tokenHash`'s identical comment. The raw token is delivered out of band (spec section 13's notification-layer event contract) and never persisted.
  tokenHash String @unique @map("token_hash")

  status InvitationStatus @default(PENDING)

  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(3)
  /// Set only on acceptance — may differ from whichever `User` row `email` originally implied if that person's account didn't exist yet at invitation time (created during acceptance) — see invitations.md "Existing vs. new user."
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  /// "This organization's pending/past invitations" — the admin-facing invitation list.
  @@index([organizationId, status])
  /// "Does this email already have a pending invitation to this org" / "what invitations exist for this email" (acceptance lookup, enumeration-safe checks — see invitations.md).
  @@index([email])
  @@map("organization_invitations")
}

// =============================================================================
// OrganizationOnboarding — Module 07 (User & Organization Management)
// =============================================================================

/// One row per organization, created alongside it (spec section 29's
/// creation transaction). `currentStep` is a plain string key — like
/// `Role.key`/`Permission.key`, not a Postgres enum — so the actual step
/// vocabulary (`lib/organizations/onboarding.ts`) stays
/// application-defined and extensible without a migration, per spec
/// section 27's explicit "do not hardcode business-specific onboarding
/// steps here."
model OrganizationOnboarding {
  id             String @id @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  currentStep String    @map("current_step")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_onboarding")
}

// =============================================================================
// OrganizationInvitationPolicy — Module 12 (Organization Security, Settings & Governance)
// =============================================================================

/// One row per organization, created lazily (on first read/write, not at
/// organization-creation time — see `invitation-policy-repository.ts`'s
/// `findOrDefault()`) rather than in `createOrganization()`'s own
/// transaction: unlike `OrganizationOnboarding` (every org genuinely
/// starts onboarding), most organizations never customize their
/// invitation policy at all, and `createInvitation()` (the enforcement
/// point — see `docs/architecture/invitation-policy.md`) needs a
/// well-defined default behavior for the common "no row yet" case
/// regardless, so forcing a row to exist earlier buys nothing.
///
/// This is Module 12's ONLY new table — see
/// `docs/architecture/organization-governance.md` "Why one narrow table,
/// not a generic OrganizationSettings" for why session/membership/
/// notification policy did NOT get columns here: none of them have real,
/// enforceable behavior behind them yet (spec's own explicit "do not
/// create settings that are not enforceable" — GENERAL settings already
/// live on `Organization` itself, unchanged).
model OrganizationInvitationPolicy {
  id             String @id @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  /// When true, `createInvitation()` requires the caller's own
  /// membership `role` to be exactly `"owner"` — narrower than the
  /// `members.invite` permission check every invitation already passes
  /// (which admins also hold). A deliberate, narrow, ADDITIVE
  /// restriction on top of the existing RBAC check, never a
  /// replacement for it — see `invitation-policy.md` "Why this is a
  /// policy layer on top of RBAC, not inside it."
  requireOwnerForInvitations Boolean @default(false) @map("require_owner_for_invitations")

  /// Canonical, lowercase, bare domains only (see
  /// `lib/organizations/domains.ts:normalizeDomain()`) — e.g.
  /// `"example.com"`, never `"Example.COM"`, `"user@example.com"`, or
  /// `"https://example.com"`. Empty array means "no allow-list
  /// configured" (every domain permitted, subject to `blockedDomains`
  /// below) — this is NOT the same as "block everything," a real
  /// footgun this module's own validation explicitly guards against
  /// (see the service layer's own comment).
  allowedDomains String[] @default([]) @map("allowed_domains")
  /// Same normalization as `allowedDomains`. Checked AFTER
  /// `allowedDomains` — see `invitation-policy.md` "Evaluation order."
  blockedDomains String[] @default([]) @map("blocked_domains")

  /// Overrides `invitation-service.ts`'s own hardcoded 7-day
  /// (`INVITATION_DURATION_MS`) default — bounded 1–720 hours (30 days)
  /// at the validation layer (`updateInvitationPolicy()`'s own Zod
  /// schema), never unbounded.
  invitationExpiryHours Int @default(168) @map("invitation_expiry_hours")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_invitation_policies")
}

// =============================================================================
// AuditEvent — Module 08 (Audit & Compliance)
// =============================================================================

/// The single, append-only source of truth for "what action did an
/// identifiable actor actually perform" across Alpha OS — see
/// docs/architecture/audit-system.md for the full design and why every
/// field below exists. No future module may create its own audit table
/// (docs/development/auditing.md) — every mutation worth auditing writes
/// here, through `lib/audit/service.ts`, never directly.
///
/// Deliberately has no `updatedAt` — this table is INSERT-only from the
/// application (enforced at the repository layer, the database-role
/// layer, and RLS below); a mutable-timestamp column on an append-only
/// table would be a contradiction in the schema itself.
model AuditEvent {
  id String @id @db.Uuid

  /// Nullable for two independent reasons: pre-tenant events are real (a
  /// login failure before any org is known, a platform-wide
  /// administrative action, an unauthenticated denied request) — never
  /// null for an organization-owned mutation at write time — and
  /// `SetNull` (never `Cascade`, tenancy-foundation.md "Audit
  /// foundation") means a hard-deleted organization also leaves this
  /// null on its old rows. Either way, `resourceName`/`actorDisplayName`
  /// below still make the record readable — the FK's job is referential
  /// integrity, not being the only copy of the identifying information.
  organizationId String? @map("organization_id") @db.Uuid

  actorType        AuditActorType @map("actor_type")
  /// `SetNull`, never `Cascade` — same reasoning as `organizationId`.
  /// Never joined for display — see `actorDisplayName`.
  actorUserId      String?        @map("actor_user_id") @db.Uuid
  /// Future SERVICE/AI actor identifier (spec Phase 28) — no table backs
  /// this yet, so it's a plain string, not a relation; this model won't
  /// need to change when that table eventually exists.
  actorServiceId   String?        @map("actor_service_id")
  /// Snapshot at the moment of the event, not a live join — the actor's
  /// `name`/`email` can change or the account can be deactivated years
  /// later; the record must still read correctly. Same reasoning
  /// Module 07 applied to `Invitation` never joining live for display.
  actorDisplayName String?        @map("actor_display_name")

  /// Canonical catalog key (`lib/audit/catalog.ts`), e.g.
  /// `"organization.suspended"`. Plain string, not an enum — the
  /// catalog must be extensible by future modules without a migration
  /// (Phase 3/36); `category`/`outcome`/`actorType` are genuinely
  /// bounded, `action` is not.
  action   String
  category AuditCategory
  outcome  AuditOutcome

  /// Plain string, not an enum, for the same extensibility reason as `action`.
  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id") @db.Uuid
  /// Snapshot, not a live join — same reasoning as `actorDisplayName`.
  resourceName String? @map("resource_name")

  /// Field-level diffs only, never a full row snapshot — see
  /// audit-system.md "State-change capture." Always passed through
  /// `lib/audit/redact.ts` before being written.
  previousState Json? @map("previous_state") @db.JsonB
  newState      Json? @map("new_state") @db.JsonB
  /// Small, bounded, action-specific extra context. Always redacted before write.
  metadata      Json? @db.JsonB

  /// Best-effort investigative signal only — never an authorization
  /// input. No established trusted-proxy model exists in this codebase;
  /// see audit-system.md "IP/UA handling."
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent") @db.VarChar(255)

  /// One HTTP request / Server Action execution — minted fresh per
  /// top-level audited call when the caller supplies none (Server
  /// Actions have no `Request` object for `lib/platform/request-id.ts`
  /// to read).
  requestId     String @map("request_id")
  /// Groups multiple audit events from one logical operation. Defaults
  /// to the same value as `requestId` for single-event operations.
  correlationId String @map("correlation_id")

  /// Server-generated (`now()` at the database) — client clock skew can
  /// never misorder an audit record.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// "This organization's recent activity" — the audit UI's primary list query.
  @@index([organizationId, createdAt])
  /// "Everything this person did."
  @@index([actorUserId, createdAt])
  /// "This specific record's history" — the investigation-workflow "follow the resource" navigation.
  @@index([resourceType, resourceId])
  /// "Every occurrence of this action" — filtering by action in the audit UI.
  @@index([action, createdAt])
  /// Correlating one request's audit trail with its application logs.
  @@index([requestId])
  /// Following one logical operation's several events.
  @@index([correlationId])
  /// Category-level filtering in the audit UI.
  @@index([category, createdAt])
  @@map("audit_events")
}

enum AuditActorType {
  /// A real, authenticated person acting through the UI.
  USER
  /// The platform itself — no identifiable human initiator (e.g. a future scheduled job).
  SYSTEM
  /// A future backend service/integration acting on its own credentials.
  SERVICE
  /// A future AI agent — never appears as a plain USER action (spec Phase 28).
  AI
  /// A future external API caller (e.g. an API key), distinct from an interactive USER session.
  API
  /// A future automated workflow/rule execution.
  AUTOMATION

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED

  @@map("audit_outcome")
}

enum AuditCategory {
  AUTHENTICATION
  AUTHORIZATION
  ORGANIZATION
  MEMBERSHIP
  INVITATION
  ROLE
  SECURITY
  DATA
  SYSTEM
  ADMINISTRATION
  COMPLIANCE
  /// Module 13 — financial/billing events. Its own category, not folded
  /// into ORGANIZATION or ADMINISTRATION: a financial subsystem's own
  /// audit trail needs to be independently filterable (spec §30/§45's
  /// own "financial/security subsystem" framing) — the same reasoning
  /// that already justified SECURITY/COMPLIANCE as their own categories
  /// rather than variants of DATA.
  BILLING
  /// Module 17 — AI conversation/usage events. Its own category for the
  /// same reason BILLING is: an AI subsystem's audit trail (who started
  /// a conversation, when a per-organization rate limit was hit) is a
  /// genuinely different concern from ORGANIZATION/ADMINISTRATION and
  /// independently filterable/reportable, especially given AI usage
  /// carries a real per-call cost.
  AI
  /// Module 18 — knowledge source/document lifecycle and retrieval
  /// rate-limit events. Deliberately its own category, not folded into
  /// AI: a knowledge-ingestion event (a document was added/deleted) is
  /// a data-governance concern independently filterable/reportable from
  /// AI usage/cost, the same reasoning that already separates BILLING
  /// from ORGANIZATION.
  KNOWLEDGE

  @@map("audit_category")
}

// =============================================================================
// Notification — Module 09 (Notification & Communication Infrastructure)
// =============================================================================
// See docs/architecture/notifications.md for the full domain-model and
// ownership-classification reasoning behind every choice below — not
// repeated per-field here.

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED

  @@map("notification_status")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("notification_severity")
}

/// A message intended for one specific person. See notifications.md
/// "Notification — recipient-owned, organization-*associated*" — the
/// access boundary is `recipientUserId`, not `organizationId`.
model Notification {
  id String @id @db.Uuid

  /// Nullable — a pre-tenant/global notification (e.g. "your password
  /// changed") is real, exactly like `AuditEvent.organizationId`. Never
  /// the SELECT boundary. `SetNull`, never `Cascade` — see the
  /// `Organization.notifications` comment.
  organizationId String? @map("organization_id") @db.Uuid

  /// The real access boundary. `Cascade` — see the `User.notifications`
  /// comment for why this is deliberately different from `AuditEvent`'s
  /// `SetNull`.
  recipientUserId String @map("recipient_user_id") @db.Uuid

  /// Extensible string key (`lib/notifications/categories.ts`), not an
  /// enum — same reasoning as `AuditEvent.action`: the category
  /// vocabulary must grow with future modules (`TICKET_ACTIVITY`,
  /// `BILLING`, ...) without a migration. Drives preference lookup and
  /// mandatory/optional policy — see `notification-preferences.md`.
  category String

  severity NotificationSeverity @default(INFO)
  status   NotificationStatus   @default(UNREAD)

  title String
  /// Human-readable body — already rendered from a template
  /// (`lib/notifications/templates.ts`) by the time this is written, not
  /// raw structured data the UI re-interprets.
  body  String

  /// Where "view" / the notification's primary action takes the user —
  /// an internal, relative path only (never an absolute/external URL —
  /// same open-redirect discipline `login/actions.ts`'s own
  /// `callbackUrl` handling already applies).
  actionUrl String? @map("action_url")

  /// Small, bounded, category-specific extra context — e.g. the
  /// membership id a `MembershipRemoved` notification refers to. Passed
  /// through the SAME `lib/audit/redact.ts` redaction Module 08 already
  /// built before being written — see notifications.md "reuse" table.
  /// Never a secret/token/credential.
  metadata Json? @db.JsonB

  /// The event this notification is a reaction to (Section 4.5) — plain
  /// columns, not a second `NotificationEvent` table (a 1:1 relationship
  /// doesn't need its own join table). `sourceEventType` is the
  /// `events.ts` event name (e.g. `"MembershipStatusChanged"`);
  /// `sourceEntityType`/`sourceEntityId` name the specific business
  /// entity involved (e.g. `"membership"` / that membership's id) —
  /// distinct from `AuditEvent.resourceType/resourceId`, which is a
  /// different record for a different purpose (evidence, not a UI
  /// message), even when they happen to describe the same underlying
  /// mutation.
  sourceEventType  String  @map("source_event_type")
  sourceEntityType String? @map("source_entity_type")
  sourceEntityId   String? @map("source_entity_id") @db.Uuid

  /// Structural duplicate prevention (Section 4.5 — "enforce this
  /// structurally where possible with database constraints", not only
  /// an application-level `if exists` check). Convention:
  /// `{sourceEventType}:{sourceEntityId}:{recipientUserId}` — see
  /// `lib/notifications/service.ts`'s `buildIdempotencyKey()`, the one
  /// place this string is constructed.
  idempotencyKey String @unique @map("idempotency_key")

  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  /// Distinct from deletion (Section 21 / notification-security.md
  /// "Retention") — an expired notification is still a real row; only a
  /// manual, documented process removes rows entirely.
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  recipient    User                   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  /// "This person's notification feed, newest first" — the primary query (cursor-paginated, see notifications.md).
  @@index([recipientUserId, createdAt])
  /// "This person's unread count" / "this person's unread feed."
  @@index([recipientUserId, status])
  /// "This organization's notification volume" — platform observability.
  @@index([organizationId, createdAt])
  /// "Did this event already produce a notification for this recipient" — the idempotency check path (also enforced structurally by the unique constraint above).
  @@index([sourceEventType, sourceEntityId])
  @@map("notifications")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  /// Reserved — no `SmsChannel` implementation exists yet (spec Section 5: "Do not implement SMS or push in this module").
  SMS
  /// Reserved — same as SMS.
  PUSH

  @@map("notification_channel")
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED

  @@map("notification_delivery_status")
}

/// One delivery ATTEMPT record per (notification, channel) — see
/// notifications.md "NotificationDelivery — operational, platform-
/// observable only." A notification with two channels (IN_APP + EMAIL)
/// has two of these. Never claims SENT merely because the application
/// called a provider — see `lib/notifications/delivery.ts`.
model NotificationDelivery {
  id             String  @id @db.Uuid
  notificationId String  @map("notification_id") @db.Uuid
  /// Denormalized from the parent `Notification` at creation time —
  /// avoids a join for the platform observability view's own filters,
  /// and is what this table's RLS INSERT policy checks (see the
  /// migration) — never trusted as a second, independent source of
  /// truth (the parent `Notification.organizationId` is canonical).
  organizationId String? @map("organization_id") @db.Uuid

  channel  NotificationChannel
  /// Provider NAME (`"console"`, later `"resend"`, ...) — plain string,
  /// not an enum, so a new provider never needs a migration. Distinct
  /// from `channel`, which is genuinely bounded.
  provider String

  status       NotificationDeliveryStatus @default(PENDING)
  attemptCount Int                        @default(0) @map("attempt_count")

  queuedAt      DateTime  @default(now()) @map("queued_at") @db.Timestamptz(3)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  /// Null once terminal (SENT, CANCELLED, or FAILED past max attempts) — see `lib/notifications/delivery.ts`'s retry classification.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)

  /// The provider's own message id, once accepted — for correlating with the provider's own dashboard/webhooks later.
  providerMessageId String? @map("provider_message_id")
  /// Machine-readable failure classification (e.g. `"invalid_recipient"`, `"provider_timeout"`) — drives retryable/terminal decisions.
  failureCode       String? @map("failure_code")
  /// Human-readable, ALREADY sanitized — never the provider's raw error body (see notification-security.md "Provider error leakage").
  failureReason     String? @map("failure_reason")
  /// Small, bounded, provider-specific context. Redacted before write, same discipline as `Notification.metadata`.
  metadata          Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// "This notification's delivery attempts across channels."
  @@index([notificationId])
  /// The retry processor's own query: "what's due for another attempt."
  @@index([status, nextAttemptAt])
  /// Platform observability: "this organization's recent delivery activity."
  @@index([organizationId, createdAt])
  @@map("notification_deliveries")
}

/// A user's own control over whether a category/channel combination is
/// attempted at all — see notifications.md "NotificationPreference —
/// global identity data, not tenant-owned" for why this table has NO
/// RLS (same category as `User`/`UserCredential`/`UserSession`) and NO
/// `organizationId` at all — global per-user, not per-organization.
model NotificationPreference {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Matches `Notification.category` — same extensible-string reasoning.
  category String
  channel  NotificationChannel

  /// The user's stated preference. NOT the final word — see
  /// `lib/notifications/policy.ts`: a mandatory category/channel
  /// combination overrides this at evaluation time regardless of what's
  /// stored here (the row can still say `false`; the policy engine
  /// ignores it for mandatory categories rather than refusing to let the
  /// row exist, which would require the UI and the database schema to
  /// independently agree on the mandatory set — one place, the policy
  /// engine, is enough).
  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One preference row per (user, category, channel) — the policy engine's own lookup key, also the structural "no duplicate preference rows" guarantee.
  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

// =============================================================================
// Billing — Module 13 (Enterprise Billing, Plans & Subscription Infrastructure)
// =============================================================================
// See docs/architecture/billing-data-model.md for the full ownership
// classification (which model is organization-owned vs. transitively-
// owned vs. platform-infrastructure, and why) and docs/architecture/billing.md
// for the domain model itself. Load-bearing principle repeated at every
// model below: Alpha OS's own tables are authoritative for application
// behavior — `provider`/`providerXxxId` columns are external references
// only, never a substitute for a real internal record. Every monetary
// column is an `Int` of MINOR units (cents) — see src/lib/utils/money.ts,
// reused here, not reimplemented.

/// The only implemented value today; an enum (not a bare string) because
/// a second provider is an explicitly anticipated future need (spec §16/
/// §49), not a hypothetical — adding one is a migration, not a rewrite of
/// every `provider` column's type.
enum BillingProvider {
  STRIPE

  @@map("billing_provider")
}

enum BillingAccountStatus {
  /// Normal state — subscriptions/invoices/payments can proceed.
  ACTIVE
  /// A payment has failed and dunning/retry is in progress at the
  /// provider — Alpha OS still shows the account, but see
  /// billing-security.md for what a PAST_DUE account can and cannot do.
  PAST_DUE
  /// Platform-staff-initiated hold (e.g. fraud review, chargeback) —
  /// distinct from PAST_DUE (a payment-lifecycle state) because
  /// SUSPENDED is a deliberate administrative action with its own
  /// authorization boundary, not something a webhook ever sets.
  SUSPENDED
  /// Terminal — same "status transition, never a delete" discipline
  /// every other lifecycle enum in this codebase uses (spec §37).
  CLOSED

  @@map("billing_account_status")
}

/// Organization-owned (RLS-protected — see billing-data-model.md). A
/// strict 1:1 with `Organization` (`organizationId @unique`) — simpler
/// than "at most one ACTIVE account among many," and sufficient: this
/// codebase has no scenario requiring an organization to hold two
/// commercial relationships with the same provider. Lazily created (no
/// row until the organization's first checkout — see billing.md), the
/// same shape `OrganizationInvitationPolicy` (Module 12) already
/// established for "most rows don't exist yet."
model BillingAccount {
  id             String @id @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  status   BillingAccountStatus @default(ACTIVE)
  /// ISO 4217. Set once, at creation, from the organization's own
  /// `Organization.currency` — see src/lib/utils/money.ts for minor-unit
  /// rules per currency. Not changed after creation in this module (spec
  /// doesn't ask for multi-currency-per-account; a currency change is a
  /// new commercial relationship, out of scope here).
  currency String

  provider           BillingProvider
  /// The provider's customer id (e.g. Stripe's `cus_...`) — an external
  /// reference, never treated as this account's real identity (spec §3).
  providerCustomerId String          @map("provider_customer_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions       Subscription[]
  invoices            Invoice[]
  payments            Payment[]
  creditLedgerEntries CreditLedgerEntry[]

  /// A provider customer id is never shared across two Alpha OS billing
  /// accounts — the structural guarantee behind "one commercial
  /// relationship per organization per provider."
  @@unique([provider, providerCustomerId])
  @@map("billing_accounts")
}

/// The internal plan catalog (spec §6) — what a customer actually
/// subscribes to. Deliberately carries NO provider reference of its own:
/// a `Plan` is a pure Alpha OS concept (name/description/whether it's
/// sellable); `PlanPrice` below is where provider linkage genuinely
/// belongs, because pricing — not the plan concept — is what a Stripe
/// `Price` object actually models. `metadata` is where a future
/// feature/limit set lives (spec's own "PlanFeature" suggestion, folded
/// in here rather than built as a separate table with no real reader
/// yet — the same restraint Module 12 applied to settings nobody could
/// enforce; see billing.md "Why there is no PlanFeature table").
model Plan {
  id          String  @id @db.Uuid
  /// Stable internal name — never renamed once referenced by a live
  /// subscription's price. The UI-facing name is `name`; nothing in the
  /// codebase should ever hardcode plan copy against this key except a
  /// seed script (spec §6: "Do NOT hardcode plan names throughout the
  /// UI" — the catalog row is the one source of truth for display copy).
  key         String  @unique
  name        String
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices PlanPrice[]

  @@map("plans")
}

/// MONTH/YEAR only (spec §6/§8's own scope) — a one-time (non-recurring)
/// charge is represented directly on an `InvoiceLineItem` without going
/// through a `PlanPrice`/`SubscriptionItem` at all (spec §9's "not every
/// invoice line is a subscription item" — see billing.md).
enum BillingInterval {
  MONTH
  YEAR

  @@map("billing_interval")
}

/// Pricing, kept deliberately separate from `Plan` (spec §6) — the same
/// plan can have several active prices (monthly/annual, future
/// currencies, grandfathered pricing) without the plan concept itself
/// changing. Platform-infrastructure-adjacent, not organization-owned —
/// see billing-data-model.md (every organization can read the active
/// catalog; only platform staff holding `billing.plan.manage` can write
/// it).
model PlanPrice {
  id     String @id @db.Uuid
  planId String @map("plan_id") @db.Uuid

  /// Internal label only (e.g. "Monthly USD") — never customer-facing
  /// copy; `Plan.name` plus `interval`/`currency` is what the UI composes
  /// for display.
  nickname   String?
  /// ISO 4217 — see src/lib/utils/money.ts.
  currency   String
  /// Minor units (spec §7) — e.g. `25000` for $250.00.
  unitAmount Int             @map("unit_amount")
  interval   BillingInterval
  active     Boolean         @default(true)

  provider        BillingProvider
  /// Nullable until synced to the provider (a price can be defined
  /// internally before it exists in Stripe — see billing-provider.md
  /// "Catalog sync").
  providerPriceId String?         @map("provider_price_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptionItems SubscriptionItem[]
  invoiceLineItems  InvoiceLineItem[]

  @@unique([provider, providerPriceId])
  @@index([planId])
  @@map("plan_prices")
}

/// Alpha OS domain states (spec §8: "Do not blindly mirror provider
/// enums") — a superset shaped closely after Stripe's own subscription
/// statuses because they already describe real, distinct business
/// states worth keeping separate, not because Stripe's vocabulary is
/// authoritative. Mapped from Stripe's own status string by
/// `stripe/mapper.ts` — see billing-provider.md "Status mapping."
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID

  @@map("subscription_status")
}

/// Organization-owned (RLS-protected). One organization may hold
/// multiple subscriptions over time (a canceled one and a new
/// replacement) — never overwritten in place; canceling creates a new
/// terminal state on the same row (spec §28: "never delete subscription
/// history"), and a genuine plan swap is a provider-side item change on
/// the SAME subscription (see SubscriptionItem below), not a new row.
model Subscription {
  id               String @id @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  billingAccountId String @map("billing_account_id") @db.Uuid

  status SubscriptionStatus @default(INCOMPLETE)

  provider               BillingProvider
  providerSubscriptionId String?         @map("provider_subscription_id")

  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at") @db.Timestamptz(3)
  trialStart         DateTime? @map("trial_start") @db.Timestamptz(3)
  trialEnd           DateTime? @map("trial_end") @db.Timestamptz(3)

  /// Out-of-order webhook guard (spec §50) — the `event.created` (Unix
  /// seconds, provider-assigned) timestamp of the most recent webhook
  /// event that successfully wrote to this row. A newly-arrived event
  /// with an EARLIER timestamp than this is a stale, out-of-order
  /// delivery and is ignored rather than applied — see
  /// billing-webhooks.md "Out-of-order events." Never advanced by
  /// anything except the webhook processor.
  providerEventTimestamp DateTime? @map("provider_event_timestamp") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount     @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  items          SubscriptionItem[]
  invoices       Invoice[]

  @@unique([provider, providerSubscriptionId])
  @@index([organizationId])
  @@index([billingAccountId])
  @@map("subscriptions")
}

/// Transitively organization-owned, through `subscriptionId` (spec
/// §31 — RLS via an EXISTS subquery to `subscriptions`, the exact
/// pattern `RolePermission` already established for a transitively-
/// owned child table — see the migration for the real policy). Exists
/// so a subscription is never "one subscription = one price forever"
/// (spec §9) — seats, add-ons, and future usage-based items are all
/// just more rows here.
model SubscriptionItem {
  id             String @id @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  planPriceId    String @map("plan_price_id") @db.Uuid

  quantity Int @default(1)

  provider       BillingProvider
  providerItemId String?         @map("provider_item_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// `Restrict` — a price still referenced by a live subscription item
  /// cannot be deleted out from under it (deactivate instead; see
  /// `PlanPrice.active`).
  planPrice    PlanPrice    @relation(fields: [planPriceId], references: [id], onDelete: Restrict)

  @@unique([provider, providerItemId])
  @@index([subscriptionId])
  @@map("subscription_items")
}

/// A pragmatic, universal invoicing lifecycle (spec §10) rather than a
/// blind mirror of Stripe's own invoice statuses — DRAFT/OPEN/PAID/VOID/
/// UNCOLLECTIBLE describe real Alpha OS business states independent of
/// which provider eventually produced the invoice.
enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE

  @@map("invoice_status")
}

/// Organization-owned (RLS-protected). `subscriptionId` is nullable —
/// an invoice can represent a subscription billing cycle OR a one-time
/// charge with no subscription behind it at all (spec §9/§11).
model Invoice {
  id               String  @id @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  billingAccountId String  @map("billing_account_id") @db.Uuid
  subscriptionId   String? @map("subscription_id") @db.Uuid

  /// Server-generated, human-facing (e.g. "INV-2026-000042") — see
  /// billing.md "Invoice numbering" for the exact scheme. NEVER a raw
  /// database id, NEVER client-supplied (spec §10).
  invoiceNumber String @unique @map("invoice_number")

  status   InvoiceStatus
  /// ISO 4217 — always matches the parent `BillingAccount.currency`.
  currency String

  /// Every amount below is an `Int` of minor units (spec §7).
  subtotal      Int @map("subtotal")
  discountTotal Int @default(0) @map("discount_total")
  taxTotal      Int @default(0) @map("tax_total")
  total         Int @map("total")
  amountPaid    Int @default(0) @map("amount_paid")
  amountDue     Int @map("amount_due")

  issueDate DateTime  @map("issue_date") @db.Timestamptz(3)
  dueDate   DateTime? @map("due_date") @db.Timestamptz(3)
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(3)

  provider          BillingProvider
  providerInvoiceId String?         @map("provider_invoice_id")
  /// Provider-hosted invoice page (e.g. Stripe's own hosted invoice URL)
  /// — Alpha OS never re-implements PDF generation (spec §25).
  hostedInvoiceUrl  String?         @map("hosted_invoice_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount    @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lineItems      InvoiceLineItem[]
  payments       Payment[]

  @@unique([provider, providerInvoiceId])
  @@index([organizationId, status])
  @@index([billingAccountId])
  @@map("invoices")
}

/// Transitively organization-owned, through `invoiceId` (RLS via an
/// EXISTS subquery, same pattern as `SubscriptionItem`). Deliberately
/// IMMUTABLE — no `updatedAt` at all, because this row is never updated
/// after creation (spec §11: "Do not dynamically recalculate historical
/// invoices from today's plan pricing"). `planPriceId` is a nullable,
/// best-effort trace back to the catalog entry active when this line
/// was written — the line's OWN `unitAmount`/`description` are what's
/// authoritative, even if that `PlanPrice` is later changed or
/// deactivated.
model InvoiceLineItem {
  id        String @id @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  description    String
  quantity       Int    @default(1)
  unitAmount     Int    @map("unit_amount")
  subtotal       Int
  discountAmount Int    @default(0) @map("discount_amount")
  taxAmount      Int    @default(0) @map("tax_amount")
  total          Int

  planPriceId String? @map("plan_price_id") @db.Uuid
  /// Small, bounded provenance/service metadata only — never a live
  /// pricing reference (see the model's own top comment).
  metadata    Json?

  /// The service period this line's revenue is EARNED over (Module 16)
  /// — Stripe's own `line.period.start`/`.end` on every invoice line,
  /// always present on the provider payload but discarded by Module 13's
  /// original webhook mapping. `null` only for line items created before
  /// Module 16's migration (never backfilled — see
  /// `revenue-recognition.md` "Known limitations"); a one-time (non-
  /// subscription) charge has `servicePeriodStart == servicePeriodEnd`
  /// (a zero-length period, Stripe's own representation of an instant),
  /// which `lib/billing/recognition/schedule.ts` recognizes as fully
  /// earned immediately — not a special case in this schema, just a real
  /// value the recognition engine already handles correctly.
  servicePeriodStart DateTime? @map("service_period_start") @db.Timestamptz(3)
  servicePeriodEnd   DateTime? @map("service_period_end") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice   Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  planPrice PlanPrice?           @relation(fields: [planPriceId], references: [id], onDelete: SetNull)
  taxes     InvoiceLineItemTax[]

  @@index([invoiceId])
  @@index([servicePeriodEnd])
  @@map("invoice_line_items")
}

/// Per-component tax detail (Module 16) — Stripe's own `line.taxes[]`,
/// captured in full for the first time (Module 13 only ever summed this
/// array into `InvoiceLineItem.taxAmount`, discarding the breakdown). A
/// single line can carry MULTIPLE simultaneous tax components (e.g. a US
/// state + county + city rate stacked on one line) — real detail that
/// cannot be reconstructed from the rolled-up sum after the fact, which
/// is the actual justification for this being a separate table rather
/// than more columns on `InvoiceLineItem` itself (spec's own "why is a
/// new table truly necessary" bar). Transitively organization-owned,
/// through `invoiceLineItemId` → `invoiceId` — same RLS shape
/// `InvoiceLineItem` itself already uses one hop up. Deliberately
/// IMMUTABLE — no `updatedAt`, no UPDATE/DELETE RLS policy (same
/// append-only discipline as its parent), written once, atomically, in
/// the SAME webhook-processing transaction that creates its parent line.
/// NOT backfilled for line items created before this migration — that
/// detail was already lost at the old webhook mapping's summing step and
/// cannot be honestly reconstructed (documented, not silently ignored).
model InvoiceLineItemTax {
  id                String @id @db.Uuid
  invoiceLineItemId String @map("invoice_line_item_id") @db.Uuid

  /// Stripe's own tax rate id (e.g. `txr_...`) — preserved as an OPAQUE
  /// reference, deliberately never resolved to a human jurisdiction name
  /// or percentage. Resolving it would require a live
  /// `stripe.taxRates.retrieve()` call this dev environment has no
  /// configured Stripe key to ever exercise or verify — see
  /// `tax-compliance.md` "Why tax rate ids are not resolved." `null` when
  /// Stripe itself returns no rate object for this component (a real,
  /// possible provider state — e.g. `reverse_charge`).
  providerTaxRateId String? @map("provider_tax_rate_id")
  /// Stripe's own already-classified reasoning for this component (e.g.
  /// `standard_rated`, `product_exempt`, `reverse_charge`,
  /// `not_collecting`) — real provider data, never inferred or computed
  /// by Alpha OS. An open-ended, provider-controlled string (Stripe's own
  /// type explicitly allows values beyond its documented list) — a
  /// Postgres enum here would break ingestion the moment Stripe adds a
  /// new reason, the same "open string, not an enum" choice this
  /// codebase already makes for `AuditEvent.resourceType`.
  taxabilityReason  String? @map("taxability_reason")
  /// `'exclusive'` or `'inclusive'` — Stripe's own field, stored as-is.
  taxBehavior       String? @map("tax_behavior")
  /// Minor units — this component's own share of the line's total tax.
  amount            Int     @map("amount")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoiceLineItem InvoiceLineItem @relation(fields: [invoiceLineItemId], references: [id], onDelete: Cascade)

  @@index([invoiceLineItemId])
  @@map("invoice_line_item_taxes")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

/// Organization-owned (RLS-protected). Never stores raw card data (spec
/// §12/§38) — `paymentMethodType`/`Brand`/`Last4` are exactly the safe,
/// already-tokenized display fields Stripe itself returns; the PAN/CVV
/// never reach Alpha OS at all (Checkout/Billing Portal are Stripe-
/// hosted — see billing-provider.md).
model Payment {
  id               String  @id @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  billingAccountId String  @map("billing_account_id") @db.Uuid
  invoiceId        String? @map("invoice_id") @db.Uuid

  amount   Int
  currency String
  status   PaymentStatus

  provider          BillingProvider
  providerPaymentId String          @map("provider_payment_id")

  paymentMethodType  String? @map("payment_method_type")
  paymentMethodBrand String? @map("payment_method_brand")
  paymentMethodLast4 String? @map("payment_method_last4")

  failureCode    String? @map("failure_code")
  /// Already a safe, provider-classified reason string (e.g.
  /// "card_declined") — never a raw provider error body (spec §42).
  failureMessage String? @map("failure_message")

  paidAt DateTime? @map("paid_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refunds        Refund[]

  @@unique([provider, providerPaymentId])
  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED

  @@map("refund_status")
}

/// Transitively organization-owned, through `paymentId` (RLS via an
/// EXISTS subquery). A refund is its OWN financial event (spec §13) —
/// the original `Payment.amount` is never mutated to represent one; see
/// billing.md "Refunds never rewrite history."
model Refund {
  id        String @id @db.Uuid
  paymentId String @map("payment_id") @db.Uuid

  amount   Int
  currency String
  reason   String?
  status   RefundStatus

  provider         BillingProvider
  providerRefundId String          @map("provider_refund_id")

  /// Staff-initiated only (spec's own adversarial §55 Q8) — null for a
  /// refund the webhook observed as issued directly in the Stripe
  /// dashboard (still recorded here for completeness, but with no
  /// Alpha OS actor to attribute).
  initiatedByUserId String? @map("initiated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  initiatedBy User?   @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRefundId])
  @@index([paymentId])
  @@map("refunds")
}

enum CreditLedgerEntryType {
  CREDIT
  DEBIT

  @@map("credit_ledger_entry_type")
}

/// Organization-owned (RLS-protected). Append-only (spec §14/§37) — no
/// `updatedAt`, no delete path anywhere in the service layer, entries
/// are NEVER edited or removed. `amount` is always positive; `type`
/// decides its sign when computing a balance — see
/// `billing/ledger.ts`'s `computeCreditBalance()`, which SUMs this table
/// on every read rather than trusting any cached total (spec §14: "If a
/// cached balance is introduced for performance, document it as a
/// projection" — no such cache exists yet; this module deliberately
/// keeps the ledger itself as the only source of truth).
model CreditLedgerEntry {
  id               String @id @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  billingAccountId String @map("billing_account_id") @db.Uuid

  type     CreditLedgerEntryType
  amount   Int
  currency String
  reason   String

  relatedInvoiceId  String? @map("related_invoice_id") @db.Uuid
  relatedPaymentId  String? @map("related_payment_id") @db.Uuid
  /// Module 14 — self-reference for a COMPENSATING entry (spec §11: "a
  /// correction happens through a compensating entry, never an UPDATE").
  /// Set only on the reversal/adjustment entry, pointing back at the
  /// original it corrects — never set on the original itself, and never
  /// retroactively backfilled onto it (that would be a mutation of an
  /// already-written row, exactly what this table's own RLS migration
  /// already structurally forbids — see billing-rls's own "no UPDATE
  /// policy" note). `onDelete: Restrict`, matching `Role`'s own
  /// deletion-safety precedent — a corrected entry can never be
  /// removed out from under its own correction.
  relatedEntryId    String? @map("related_entry_id") @db.Uuid
  /// Module 14 — the platform-staff actor who issued/adjusted this
  /// entry, if any. Null for a webhook-driven or system-originated
  /// entry (none exist yet in this module — see credit-service.ts's own
  /// top comment) and for `seed-billing.ts`'s dev fixtures. `Refund`
  /// already carries the identical field for the identical reason (spec
  /// §44's "capture WHO").
  initiatedByUserId String? @map("initiated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingAccount BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  relatedEntry   CreditLedgerEntry?  @relation("CreditLedgerEntryCorrection", fields: [relatedEntryId], references: [id], onDelete: Restrict)
  corrections    CreditLedgerEntry[] @relation("CreditLedgerEntryCorrection")
  initiatedBy    User?               @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  /// Module 14 — AT MOST ONE compensating entry per original (Postgres
  /// unique constraints allow unlimited NULLs but enforce uniqueness
  /// among non-null values — exactly "most rows don't correct anything,
  /// and the ones that do, do so exactly once"). This IS
  /// `adjustCredit()`'s real concurrency guarantee (spec §17: "credit
  /// adjustments racing") — preferred over `SELECT ... FOR UPDATE` row
  /// locking specifically because this table's own RLS has no UPDATE
  /// policy at all (append-only); a real database constraint is both
  /// simpler and avoids ever depending on how Postgres RLS interacts
  /// with locking reads on a table with no UPDATE policy. Two
  /// concurrent adjustment attempts against the same original entry:
  /// exactly one INSERT succeeds, the other fails this constraint —
  /// proven under real concurrency, not just reasoned about, in
  /// `credit-concurrency.test.ts`.
  @@unique([relatedEntryId])
  @@index([organizationId])
  @@index([billingAccountId])
  @@map("credit_ledger_entries")
}

enum BillingWebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  /// A real, verified event of a type this module deliberately does not
  /// act on (spec §19's "document intentionally unsupported events") —
  /// recorded for idempotency/observability, never retried.
  IGNORED

  @@map("billing_webhook_event_status")
}

/// Platform infrastructure, NOT tenant data — deliberately NO RLS and NO
/// `organizationId` column (spec §31's own "webhook-event records may
/// require a different platform/infrastructure classification"; see
/// billing-webhooks.md "Why this table has no RLS" for the full
/// reasoning). Accessed exclusively through the plain `db` client, from
/// the webhook route handler (which has no user session at all — there
/// is no tenant context to set) and the platform observability read
/// path — the same infrastructure-table precedent `UserSession`/rate-
/// limit records already established elsewhere in this codebase.
///
/// `@@unique([provider, providerEventId])` is THE idempotency guarantee
/// (spec §18) — a real database constraint, not just an application-
/// level pre-check: two concurrent deliveries of the same event can
/// both attempt an insert, but only one ever succeeds.
model BillingWebhookEvent {
  id String @id @db.Uuid

  provider        BillingProvider
  providerEventId String          @map("provider_event_id")
  eventType       String          @map("event_type")

  /// The verified, raw provider event payload — kept for idempotency
  /// proof, debugging, and future reconciliation (spec §48). Never
  /// rendered to any customer-facing surface; never placed into an audit
  /// event's metadata (spec §30's redaction rule still applies to
  /// whatever reads FROM this column, even though this column itself is
  /// not audit-redacted — see billing-security.md).
  payload Json

  status BillingWebhookEventStatus @default(PENDING)
  /// Safe, already-sanitized failure description only — never a raw
  /// stack trace or secret (spec §42/§47).
  error  String?

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("billing_webhook_events")
}

// =============================================================================
// AI (Module 17 — AI Infrastructure & Intelligence Foundation)
// =============================================================================
//
// A real, working AI support-chat capability (Anthropic's Claude,
// through the provider abstraction in `lib/ai/provider/`) — not tool-
// calling/agentic actions on the customer's behalf (that's a
// structurally different, higher-risk surface reserved for a future
// "AI Tool System" module — see `AIActionCard` in
// `components/shared/ai-chat.tsx`, whose own doc comment already
// anticipates this boundary) and not grounded in a specific
// organization's live account/billing data (no function-calling into
// this platform's own data in this module — a real, deliberate scope
// boundary, not an oversight; see `ai-infrastructure.md` "What this
// does NOT claim to be"). See that same doc for the full architecture.

/// Organization-owned (direct `organization_id`, standard tenant-
/// isolation RLS — the same shape `Subscription`/`Invoice` already use)
/// AND user-owned (`user_id` — the conversation's starter). RLS handles
/// the ORGANIZATION boundary (never cross-tenant); the finer-grained
/// "only this user, or `ai.manage`/`ai.observability`, may view this
/// specific conversation" rule is an APPLICATION-layer check, the same
/// "RLS for tenant isolation, service layer for finer business rules"
/// layering Module 10's own user-detail activity panel already
/// established — RLS is not the right tool for a WITHIN-tenant
/// visibility rule that depends on which permission the caller holds.
model AiConversation {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  status AiConversationStatus @default(OPEN)
  /// Derived from the first user message (truncated) at creation time —
  /// display convenience only, never re-derived/edited afterward.
  title  String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([organizationId, updatedAt])
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

enum AiConversationStatus {
  OPEN
  CLOSED

  @@map("ai_conversation_status")
}

/// Transitively organization-owned, through `conversation_id` (RLS via
/// an EXISTS subquery, the same pattern `InvoiceLineItem` already uses
/// one hop up). Deliberately IMMUTABLE — no `updatedAt`, no UPDATE/
/// DELETE RLS policy: a chat transcript, like an audit event, is a
/// record of what was actually said, not something to revise after the
/// fact. Usage/cost fields are denormalized directly onto the message
/// row (only ever populated for `ASSISTANT` messages) rather than a
/// separate usage-log table — one real API call maps to exactly one
/// `ASSISTANT` message, so a second table would just be a 1:1 join with
/// no independent lifecycle of its own (contrast with Module 16's
/// `InvoiceLineItemTax`, which genuinely needs its own table because ONE
/// line item can carry MULTIPLE simultaneous tax components).
model AiMessage {
  id             String        @id @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String

  /// Real Anthropic API response fields — `null` for USER messages.
  model             String? @map("model")
  inputTokens       Int?    @map("input_tokens")
  outputTokens      Int?    @map("output_tokens")
  /// Minor units (matches this codebase's money convention everywhere
  /// else) — an ESTIMATE from a locally-maintained pricing table, not a
  /// verified invoice figure. See `ai-infrastructure.md` "Cost
  /// estimation — an honest limitation."
  costMinorUnits    Int?    @map("cost_minor_units")
  latencyMs         Int?    @map("latency_ms")
  providerMessageId String? @map("provider_message_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiMessageRole {
  USER
  ASSISTANT

  @@map("ai_message_role")
}

// =============================================================================
// Knowledge & Retrieval — Module 18 (AI Knowledge, Context & Retrieval
// Infrastructure)
// =============================================================================
// The enterprise knowledge/retrieval foundation future AI modules
// (agents, copilots, a real support assistant grounded in account data)
// will consume. See docs/architecture/ai-knowledge.md for the full
// architecture, docs/architecture/retrieval.md for the hybrid-search/
// pgvector design, docs/architecture/knowledge-security.md for the
// authorization-before-retrieval trust model this schema exists to
// support. NOT wired into Module 17's existing AI chat — a deliberate
// scope boundary (see ai-knowledge.md "What this module is, and is
// not").
//
// Ownership classification (spec §25 — decided per table, documented,
// not assumed uniform):
//   - KnowledgeSource / KnowledgeDocument: organization-owned when
//     `organizationId` is set, PLATFORM-owned (shared, global reference
//     data — Alpha OS's own product docs/policies) when NULL. The exact
//     nullable-organizationId shape `AuditEvent.organizationId` already
//     established for a different reason (survives org deletion) — here
//     the reason is different (a source can be *intentionally*
//     platform-wide from creation, not just orphaned later), but the
//     RLS shape this enables is the SAME one `roles`/`role_permissions`
//     already use for "global reference data, visible to everyone" (see
//     rls.md "Protected tables") — reused deliberately, not
//     reinvented.
//   - KnowledgeDocumentVersion / KnowledgeChunk / KnowledgeEmbedding:
//     transitively owned through their parent chain. `KnowledgeChunk`
//     denormalizes `organizationId` directly (nullable, same meaning)
//     for RLS/query simplicity — the same `Subscription`/`Invoice`/
//     `Payment` precedent (`Organization`'s own reverse-relation
//     comment above) applied here because retrieval is this table's
//     hottest, highest-volume query path and a 3-hop transitive EXISTS
//     (chunk -> version -> document -> source -> organization) would be
//     real, avoidable overhead on every single retrieval call.
//     `KnowledgeEmbedding` stays transitively owned via `chunkId` (one
//     hop to the now-denormalized `KnowledgeChunk.organizationId`) — the
//     same one-hop `EXISTS` shape `ai_messages` already uses via
//     `conversation_id`.
//
// Deletion strategy (spec §17, `src/types/lifecycle.ts`):
//   - `KnowledgeSource`: Archivable (`status` + no hard/soft delete) —
//     disabling a source stops new ingestion/retrieval without erasing
//     its documents' history, the same reasoning `Organization` is
//     Archivable.
//   - `KnowledgeDocument`: Softdeletable (`deletedAt`/`deletedBy`) —
//     `lifecycle.ts`'s own top comment names "documents" as the
//     canonical Softdeletable example. Deleting a document does NOT
//     cascade-delete its versions/chunks/embeddings (they remain for a
//     possible future restore/audit need) — retrieval and every
//     document-listing query filter `deletedAt IS NULL` explicitly, so
//     no chunk/embedding belonging to a deleted document is ever
//     reachable through the application, even though the rows
//     physically remain (proven directly by a dedicated security test
//     that queries the raw table alongside the retrieval path — see
//     knowledge-security.md "Deletion — soft, but genuinely
//     unreachable").
//   - `KnowledgeChunk` / `KnowledgeEmbedding`: immutable and append-only,
//     the same discipline `AiMessage`/`AuditEvent` already establish —
//     no UPDATE/DELETE RLS policy at all (see the migration).
//     `KnowledgeDocumentVersion` is PROCESSING-STATE mutable instead
//     (its own `status`/`failureReason`/`chunkCount`/`readyAt` change
//     as ingestion proceeds — a real UPDATE RLS policy exists for it;
//     see the migration's own top comment for the correction this
//     went through) — its CONTENT (`content`/`contentChecksum`/
//     `versionNumber`) stays immutable in practice. Re-indexing (a
//     chunking-strategy or embedding-model change) ADDS new chunk/
//     embedding rows rather than mutating existing ones — "never
//     mutate old embeddings into new meanings" (spec §16) — old rows
//     simply stop being selected by retrieval
//     once it's reconfigured to query the CURRENT strategy/model
//     (`KnowledgeChunk.chunkingStrategy` / `KnowledgeEmbedding.model`),
//     never deleted.

/// A knowledge source — the reusable abstraction future connectors
/// (website content, CRM records, uploaded files, ...) implement.
/// `MANUAL` is the only type with a real ingestion pathway in this
/// module (a staff member pastes or uploads a plain-text/markdown
/// document directly) — see ai-knowledge.md "Why only one source type
/// is implemented" for the same "build the abstraction, not every
/// future connector" reasoning `lib/ai/provider/interface.ts` already
/// applies to a second AI chat provider.
model KnowledgeSource {
  id             String  @id @db.Uuid
  /// `null` = a platform-level source (Alpha OS's own product docs/
  /// policies), visible to every organization — see the RLS policy in
  /// the migration and the block comment above.
  organizationId String? @map("organization_id") @db.Uuid

  type KnowledgeSourceType

  name        String
  description String?

  status KnowledgeSourceStatus @default(ACTIVE)

  /// Usable by retrieval policy today, not a decorative label: a
  /// caller holding only `knowledge.retrieve` (not `knowledge.source.manage`)
  /// may retrieve from PUBLIC/INTERNAL sources but not CONFIDENTIAL/
  /// RESTRICTED ones — see knowledge-security.md "Classification is an
  /// access tier, not a label." No separate "visibility" field: this
  /// codebase has no sub-organization audience concept (teams,
  /// departments) that a distinct visibility axis could meaningfully
  /// enforce yet — adding one now would be exactly the "field without
  /// architectural justification" this schema's own conventions warn
  /// against (data-modeling.md).
  classification DataClassification @default(INTERNAL)

  /// Free-form, settings-shaped config a future connector type would
  /// need (a website's crawl root, a CRM's object filter) — genuinely
  /// unstructured and not queried/indexed on its own, the same
  /// `Organization.metadata` justification (data-modeling.md "JSON/JSONB
  /// strategy"). `null` for `MANUAL` sources, which need none.
  metadata Json?

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    KnowledgeDocument[]

  @@index([organizationId, status])
  @@map("knowledge_sources")
}

enum KnowledgeSourceType {
  MANUAL

  @@map("knowledge_source_type")
}

enum KnowledgeSourceStatus {
  ACTIVE
  DISABLED
  ARCHIVED

  @@map("knowledge_source_status")
}

/// Four principled tiers (spec §11), reused wherever this codebase needs
/// a data-sensitivity classification — not a per-module enum. `PUBLIC`
/// has no real gating effect today (every classification below
/// CONFIDENTIAL is retrievable by any `knowledge.retrieve` holder); it
/// exists as the honest bottom tier for content a future public-facing
/// surface (a documentation site, an unauthenticated help widget) could
/// eventually read without becoming meaningless in the meantime.
enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED

  @@map("data_classification")
}

/// A document within a source. `organizationId` is denormalized from
/// `source.organizationId` at creation time (never re-derived — a
/// document cannot move between organizations) purely for query/RLS
/// convenience, the same `Subscription`/`Invoice` precedent noted above.
model KnowledgeDocument {
  id             String  @id @db.Uuid
  sourceId       String  @map("source_id") @db.Uuid
  /// Denormalized from `source.organizationId` — see this model's own
  /// top comment.
  organizationId String? @map("organization_id") @db.Uuid

  title       String
  /// A stable identifier for THIS piece of content within its source
  /// (e.g. a file path, a CRM record id) — what makes re-ingesting the
  /// "same" document idempotent rather than creating a duplicate. `null`
  /// is allowed (an ad hoc pasted document with no natural external
  /// identity) but then re-ingestion always creates a NEW document, by
  /// design — there is nothing to match against.
  canonicalId String? @map("canonical_id")
  /// Defaults to plain text — this module ingests text content only
  /// (pasted, or extracted server-side from an uploaded `.txt`/`.md`
  /// file); no OCR, no binary format parsing. See ai-knowledge.md
  /// "Text-only ingestion — an honest limitation."
  contentType String  @default("text/plain") @map("content_type")

  /// The current READY version's id, or `null` before the first
  /// ingestion ever completes successfully — never points at a FAILED
  /// version (see knowledge-ingestion-service.ts). This, not a separate
  /// `status` enum, is what distinguishes "not yet ingested" from
  /// "ready" — a document's own lifecycle is fully expressed by
  /// `currentVersionId` (ready or not) and `deletedAt` (soft-deleted or
  /// not); a third, redundant status axis would duplicate one of those
  /// two, the exact anti-pattern data-modeling.md's own "don't blindly
  /// add fields" guidance warns against.
  currentVersionId String? @unique @map("current_version_id") @db.Uuid

  metadata Json?

  /// Softdeletable (`src/types/lifecycle.ts`) — see this model's own
  /// deletion-strategy note in the file-level comment above.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy String?   @map("deleted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  source         KnowledgeSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  organization   Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       KnowledgeDocumentVersion[] @relation("DocumentVersions")
  currentVersion KnowledgeDocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@index([sourceId, deletedAt])
  @@index([organizationId, deletedAt])
  @@map("knowledge_documents")
}

/// A new ingestion always creates a NEW version (spec §3); historical
/// versions' CONTENT is never overwritten — `content`/`contentChecksum`/
/// `versionNumber` are immutable in practice (no UPDATE call site ever
/// touches them). `status`/`failureReason`/`chunkCount`/`readyAt` ARE
/// real, legitimate UPDATE targets — see the migration's own top
/// comment for the correction this went through (a first draft wrongly
/// modeled this table as fully immutable like `AiMessage`, caught by
/// this module's own integration tests). `content` holds the real
/// ingested text (this module's only supported content shape — see
/// `KnowledgeDocument.contentType`'s own comment).
model KnowledgeDocumentVersion {
  id         String @id @db.Uuid
  documentId String @map("document_id") @db.Uuid

  versionNumber   Int    @map("version_number")
  content         String
  /// SHA-256 hex of `content` — the idempotency key `ingestText()` uses
  /// to detect "this is genuinely the same content again" and skip
  /// creating a duplicate version (spec §15 — "running the same
  /// ingestion twice must not create duplicate logical knowledge").
  contentChecksum String @map("content_checksum")

  /// Deliberately scoped to what a VERSION can actually be — the full
  /// spec §15 vocabulary (DISCOVERED/.../DELETED) mixes per-version
  /// processing state with per-DOCUMENT lifecycle state that belongs on
  /// `KnowledgeDocument` instead: "DISCOVERED" is implicit (a document
  /// with zero versions), "DELETED" is `KnowledgeDocument.deletedAt`.
  /// See ai-knowledge.md "Ingestion lifecycle" for the full mapping.
  status        KnowledgeIngestionStatus @default(QUEUED)
  failureReason String?                  @map("failure_reason")
  /// Denormalized once processing completes — cheap display without a
  /// COUNT query on every document list row.
  chunkCount    Int?                     @map("chunk_count")

  /// Real ingestion metadata (e.g. the uploaded filename, submitter) —
  /// genuinely unstructured, same `Organization.metadata` justification.
  sourceMetadata Json? @map("source_metadata")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readyAt   DateTime? @map("ready_at") @db.Timestamptz(3)

  document           KnowledgeDocument  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentForDocument KnowledgeDocument? @relation("CurrentVersion")
  chunks             KnowledgeChunk[]

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@map("knowledge_document_versions")
}

enum KnowledgeIngestionStatus {
  QUEUED
  PROCESSING
  CHUNKING
  EMBEDDING
  READY
  FAILED
  /// A version that used to be `currentVersionId` before a newer
  /// version became ready — kept fully identifiable (spec §3: "historical
  /// versions must remain identifiable"), never deleted or relabeled.
  SUPERSEDED

  @@map("knowledge_ingestion_status")
}

/// A deterministic chunk of one document version's content. Multiple
/// chunk SETS (distinguished by `chunkingStrategy`) may coexist for the
/// same version — re-chunking with a new strategy ADDS rows, it does not
/// replace the old ones (spec §16) — retrieval always filters to the
/// CURRENT configured strategy (`lib/knowledge/chunking.ts`).
model KnowledgeChunk {
  id                String  @id @db.Uuid
  documentVersionId String  @map("document_version_id") @db.Uuid
  /// Denormalized from the document/source chain — see this file's
  /// top-level ownership comment for why (RLS/query cost on the hottest
  /// retrieval path).
  organizationId    String? @map("organization_id") @db.Uuid

  /// Position within THIS chunking strategy's own sequence, zero-based.
  sequence Int
  content  String

  charCount  Int    @map("char_count")
  /// A character-based ESTIMATE (see `lib/knowledge/chunking.ts`'s own
  /// comment for the exact heuristic) — this codebase has no tokenizer
  /// dependency; stated honestly as an estimate, the same discipline
  /// `lib/ai/pricing.ts`'s own cost figures already apply.
  tokenCount Int?   @map("token_count")
  checksum   String

  /// e.g. `"fixed-char-v1"` — see `lib/knowledge/chunking.ts`. A
  /// versioned STRING, not an enum: a new chunking strategy is a
  /// deployable code change, not a schema migration (the same
  /// `OrganizationMembership.role`-is-a-string reasoning data-modeling.md
  /// already documents for an analogous "controlled by code, not by an
  /// admin, but shouldn't need a migration to add a value" case).
  chunkingStrategy String @map("chunking_strategy")

  /// Real structural context extracted during chunking (e.g. a heading
  /// the chunk falls under) — genuinely unstructured per-chunk metadata.
  structuralMetadata Json? @map("structural_metadata")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  documentVersion KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  embeddings      KnowledgeEmbedding[]

  @@unique([documentVersionId, chunkingStrategy, sequence])
  @@index([organizationId])
  @@map("knowledge_chunks")
}

/// One embedding of one chunk, by one (provider, model). Its OWN table,
/// not columns on `KnowledgeChunk` — spec §5's own "never assume all
/// embeddings are interchangeable": a chunk legitimately has MULTIPLE
/// simultaneous embeddings over its lifetime (a model upgrade adds a
/// new row rather than overwriting the old vector), the same genuine
/// 1:many reasoning `InvoiceLineItemTax` already established for "one
/// parent, multiple simultaneous typed children" (contrast `AiMessage`,
/// which does NOT get a separate table because it's genuinely 1:1).
///
/// `vector` is `Unsupported(...)` — Prisma has no native pgvector
/// scalar; every read/write of this column goes through raw,
/// PARAMETERIZED SQL (`$queryRaw`/`$executeRaw` — never string
/// concatenation) in `knowledge-embedding-repository.ts`. Fixed at
/// 1536 dimensions (`text-embedding-3-small`'s real output size) —
/// see `docs/architecture/retrieval.md` "Embedding dimension is a
/// schema decision, not a config one" for why changing the configured
/// model to one with a different dimension requires a new migration,
/// not just an env var change.
model KnowledgeEmbedding {
  id      String @id @db.Uuid
  chunkId String @map("chunk_id") @db.Uuid

  provider  String
  model     String
  dimension Int

  /// @db.Unsupported — see this model's own top comment.
  vector Unsupported("vector(1536)")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, provider, model])
  @@map("knowledge_embeddings")
}
