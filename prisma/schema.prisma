// =============================================================================
// Sales Pipeline — Build 20 (Canonical Roadmap Module 14)
// =============================================================================
// Extends the CRM domain above (Build 19 / Roadmap Module 13) — see
// docs/architecture/sales-pipeline.md. Every row here is owned exclusively
// by the one platform organization, exactly like every CRM table above;
// never a customer organization, never client-supplied. "Deal" is this
// codebase's one canonical term for a sales opportunity (see that doc's
// own "Terminology" section for why "Deal", not "Opportunity").

model CrmPipeline {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name      String
  status    CrmPipelineStatus @default(ACTIVE)
  isDefault Boolean           @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       CrmPipelineStage[]
  deals        CrmDeal[]

  // A partial unique index enforcing "at most one default pipeline per
  // organization" is hand-written in the migration (Prisma has no
  // `@@unique` filtered-index syntax) — see that migration's own comment.
  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("crm_pipelines")
}

enum CrmPipelineStatus {
  ACTIVE
  ARCHIVED

  @@map("crm_pipeline_status")
}

model CrmPipelineStage {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  pipelineId     String @map("pipeline_id") @db.Uuid

  name               String
  /// Gap-based ordering (seeded in increments of 1000) — see
  /// `crm-pipeline-stage-service.ts`'s own `moveStage()` comment for the
  /// midpoint-renumber strategy this enables without a full-table
  /// renumber on every reorder.
  sortOrder          Int                    @default(0) @map("sort_order")
  status             CrmPipelineStageStatus @default(ACTIVE)
  /// Descriptive/board-display hints only — NOT the lifecycle authority.
  /// `CrmDeal.status` is authoritative; the deal service keeps a deal's
  /// status consistent with these flags via `winDeal()`/`loseDeal()`,
  /// never via a bare stage move. See sales-pipeline.md "Won/lost
  /// semantics."
  isWon              Boolean                @default(false) @map("is_won")
  isLost             Boolean                @default(false) @map("is_lost")
  /// Pre-fills a new/moved-into deal's own `probability` — never
  /// silently overwrites a deal's existing, user-set probability. Null
  /// means "no default for this stage."
  defaultProbability Int?                   @map("default_probability")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     CrmPipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals        CrmDeal[]

  @@unique([pipelineId, name])
  @@index([organizationId, pipelineId, sortOrder])
  @@map("crm_pipeline_stages")
}

enum CrmPipelineStageStatus {
  ACTIVE
  ARCHIVED

  @@map("crm_pipeline_stage_status")
}

model CrmDeal {
  id               String  @id @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  pipelineId       String  @map("pipeline_id") @db.Uuid
  stageId          String  @map("stage_id") @db.Uuid
  companyId        String  @map("company_id") @db.Uuid
  primaryContactId String? @map("primary_contact_id") @db.Uuid
  sourceLeadId     String? @map("source_lead_id") @db.Uuid

  title             String
  /// Integer minor units — see src/lib/utils/money.ts. Never a
  /// JavaScript float. CHECK (value_minor_units >= 0) in the migration.
  valueMinorUnits   Int           @default(0) @map("value_minor_units")
  /// ISO 4217 — same free-string convention as `Organization.currency`/
  /// `BillingAccount.currency` (not an enum).
  currency          String        @default("USD")
  /// Integer percentage, 0-100 — see sales-pipeline.md "Probability."
  /// CHECK (probability IS NULL OR probability BETWEEN 0 AND 100).
  probability       Int?
  expectedCloseDate DateTime?     @map("expected_close_date") @db.Timestamptz(3)
  status            CrmDealStatus @default(OPEN)
  assignedToUserId  String?       @map("assigned_to_user_id") @db.Uuid
  lossReason        String?       @map("loss_reason")
  wonAt             DateTime?     @map("won_at") @db.Timestamptz(3)
  lostAt            DateTime?     @map("lost_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                     Organization                           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline                         CrmPipeline                            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage                            CrmPipelineStage                       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  company                          CrmCompany                             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryContact                   CrmContact?                            @relation("CrmDealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  sourceLead                       CrmLead?                               @relation("CrmDealSourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  assignedToUser                   User?                                  @relation("CrmDealAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  history                          CrmDealHistory[]
  proposals                        CrmProposal[]
  contracts                        CrmContract[]
  /// Build 23 — `[]`, not a singular relation: a cancelled onboarding
  /// never resurrects, a retry creates a NEW row (see
  /// `CrmClientOnboarding`'s own comment), so a deal can legitimately
  /// have more than one over time, historically.
  onboardings                      CrmClientOnboarding[]
  /// Build 25 — expansion opportunities explicitly handed off to Sales
  /// and linked to THIS existing deal (never auto-created by Client
  /// Success — see `CrmClientSuccessExpansionOpportunity`'s own comment).
  clientSuccessExpansionsHandedOff CrmClientSuccessExpansionOpportunity[] @relation("CrmClientSuccessExpansionHandedToDeal")

  @@index([organizationId, status, createdAt])
  @@index([organizationId, pipelineId, stageId])
  @@index([organizationId, pipelineId, status, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, expectedCloseDate])
  @@index([companyId, createdAt])
  @@index([assignedToUserId, status])
  @@index([sourceLeadId])
  // A further partial index, `crm_deals_organization_id_won_at_idx`
  // (`organization_id, won_at WHERE status = 'WON'`), backs
  // `wonValueByCurrency()`'s forecast query — Prisma cannot express a
  // partial index via `@@index`, so it's hand-written directly in the
  // `sales_pipeline_query_indexes` migration only (same limitation as
  // `crm_pipelines_one_default_per_org` above).
  @@map("crm_deals")
}

enum CrmDealStatus {
  OPEN
  WON
  LOST

  @@map("crm_deal_status")
}

model CrmDealHistory {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  dealId         String @map("deal_id") @db.Uuid

  type        CrmDealHistoryType
  /// Small, bounded field-level detail only — never a full row dump.
  /// E.g. `{"from":"NEW","to":"CONTACTED"}` for STAGE_CHANGED,
  /// `{"fromMinorUnits":..,"toMinorUnits":..,"currency":"USD"}` for
  /// VALUE_CHANGED. See sales-pipeline.md "Deal history."
  metadata    Json?
  /// Free-text body — populated for the one user-authorable type, NOTE;
  /// system-generated types leave this null and rely on `metadata`.
  note        String?
  actorUserId String             @map("actor_user_id") @db.Uuid
  occurredAt  DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         CrmDeal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorUser    User         @relation("CrmDealHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, dealId, occurredAt])
  // A further partial index, `crm_deal_history_org_type_occurred_close_idx`
  // (`organization_id, type, occurred_at INCLUDE (actor_user_id, deal_id)
  // WHERE type IN ('WON','LOST')`), backs Build 21's own
  // `crmSalesPerformanceRepository.closedDealsByActor()` — Prisma cannot
  // express a partial/covering index via `@@index`, so it's hand-written
  // directly in the `sales_team_deal_history_close_index` migration only
  // (same limitation as `crm_deals_organization_id_won_at_idx`, Build 20).
  @@map("crm_deal_history")
}

enum CrmDealHistoryType {
  CREATED
  STAGE_CHANGED
  VALUE_CHANGED
  PROBABILITY_CHANGED
  EXPECTED_CLOSE_DATE_CHANGED
  OWNER_CHANGED
  WON
  LOST
  REOPENED
  NOTE

  @@map("crm_deal_history_type")
}

// --- Build 21 (Roadmap Module 15) — Sales Team Management. Extends the
// CRM/Sales Pipeline foundation (Build 19/20) with real sales-team
// participation, targets/quotas, and deterministic performance
// reporting — never a second identity system, never a duplicate Deal/
// Lead/activity table. See docs/architecture/sales-team-management.md.

/// A rep's explicit participation in Alpha Page Rankers' own internal
/// sales team — always references an existing `User`, never a second
/// identity. NOT every platform-staff member is a sales rep: this row's
/// mere existence (and `status`) is the explicit opt-in the master
/// prompt requires. `status` is INACTIVE on removal, never a hard
/// delete — `CrmSalesGoal`/attribution reporting must keep referencing
/// a past member by id. `managerId` is an optional self-reference (the
/// narrowest possible "team" concept — see the architecture doc's own
/// "Sales team model" section for why a separate `SalesTeam` grouping
/// entity was deliberately NOT built).
model CrmSalesTeamMember {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  status    CrmSalesTeamMemberStatus @default(ACTIVE)
  /// Self-reference — this member's manager, also a
  /// `CrmSalesTeamMember` (i.e. the manager must themselves be an
  /// explicit sales-team participant, not merely any platform user).
  managerId String?                  @map("manager_id") @db.Uuid

  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                 @relation("CrmSalesTeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  manager       CrmSalesTeamMember?  @relation("CrmSalesTeamMemberManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports CrmSalesTeamMember[] @relation("CrmSalesTeamMemberManager")
  goals         CrmSalesGoal[]

  // At most one ACTIVE row per (organizationId, userId) — a hand-written
  // partial unique index (see migration; Prisma cannot express `@@unique`
  // with a WHERE clause), the same pattern `crm_pipelines_one_default_
  // per_org` already established in Build 20. A rep who left and later
  // rejoined gets a NEW row, not a reactivated one — the old row (and
  // every goal/attribution that references it) stays exactly as it was.
  @@index([organizationId, status])
  @@index([userId])
  @@index([managerId])
  @@map("crm_sales_team_members")
}

enum CrmSalesTeamMemberStatus {
  ACTIVE
  INACTIVE

  @@map("crm_sales_team_member_status")
}

/// A target (informal, operational) or quota (formal performance
/// threshold) for one metric over one explicit period — one unified
/// model rather than two near-duplicate tables, distinguished by `kind`.
/// `salesTeamMemberId` null means an organization-wide/whole-team goal.
/// Immutable once created except for `status` (ACTIVE -> ARCHIVED) — a
/// mistaken value/period is corrected by archiving and creating a new
/// goal, never an in-place edit, avoiding the update-race class of bug
/// entirely (see the architecture doc's own "Concurrency" section) and
/// keeping the centralized audit log's "target/quota created/archived"
/// entries a complete, honest history without a second history table.
model CrmSalesGoal {
  id                String  @id @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  salesTeamMemberId String? @map("sales_team_member_id") @db.Uuid

  kind   CrmSalesGoalKind
  metric CrmSalesGoalMetric

  /// Exactly one of these three is set, matching `metric`'s own value
  /// kind — enforced by a CHECK constraint (the migration's own
  /// `num_nonnulls()`-style pattern, first established for
  /// `CrmActivity`'s exactly-one-parent constraint in Build 19).
  /// Integer minor units — REVENUE_WON only. Same convention as
  /// `CrmDeal.valueMinorUnits`; never a JS float.
  valueMinorUnits Int?    @map("value_minor_units")
  /// ISO 4217 — required exactly when `valueMinorUnits` is set.
  currency        String? @db.VarChar(3)
  /// Plain integer count — DEALS_WON / CALLS_LOGGED / APPOINTMENTS_LOGGED only.
  valueCount      Int?    @map("value_count")
  /// Integer percentage, 0-100 — LEAD_CONVERSION_RATE only.
  valuePercent    Int?    @map("value_percent")

  /// Half-open `[periodStart, periodEnd)` — see
  /// `src/lib/billing/reporting/period.ts`'s own `FinancialPeriod`
  /// convention, reused directly for this goal's own period at creation
  /// time (never re-derived at read time). Anchored to UTC — see the
  /// architecture doc's own "Period semantics" for why (this module has
  /// no per-organization timezone to anchor to; same reasoning Module
  /// 17's `ai-observability-service.ts` already documents for its own
  /// platform-wide UTC anchor).
  periodStart DateTime @map("period_start") @db.Timestamptz(3)
  /// Exclusive.
  periodEnd   DateTime @map("period_end") @db.Timestamptz(3)
  /// The named period this was resolved from (`FinancialPeriod.label`),
  /// or `"custom"` — display/audit context only, never re-derived from
  /// `periodStart`/`periodEnd` alone.
  periodLabel String   @map("period_label")

  status CrmSalesGoalStatus @default(ACTIVE)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesTeamMember CrmSalesTeamMember? @relation(fields: [salesTeamMemberId], references: [id], onDelete: Cascade)
  createdByUser   User                @relation("CrmSalesGoalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // No two ACTIVE goals for the same (organizationId, salesTeamMemberId
  // [org-wide goals coalesced to one sentinel group], kind, metric) may
  // have overlapping periods — a hand-written `EXCLUDE USING gist`
  // constraint (see migration; Prisma cannot express this), the
  // strongest honest answer to "prevent ambiguous overlapping records"
  // the master prompt asks for, not merely an application-layer check.
  @@index([organizationId, salesTeamMemberId, status])
  @@index([organizationId, kind, metric, status])
  @@map("crm_sales_goals")
}

enum CrmSalesGoalKind {
  /// Desired operational metric — informal, not a formal attainment threshold.
  TARGET
  /// Formal performance threshold.
  QUOTA

  @@map("crm_sales_goal_kind")
}

enum CrmSalesGoalMetric {
  REVENUE_WON
  DEALS_WON
  CALLS_LOGGED
  APPOINTMENTS_LOGGED
  LEAD_CONVERSION_RATE

  @@map("crm_sales_goal_metric")
}

enum CrmSalesGoalStatus {
  ACTIVE
  ARCHIVED

  @@map("crm_sales_goal_status")
}

// --- Build 22 (Roadmap Module 16) — Proposals & Contracts. Bridges Sales
// Pipeline (Build 20) into future Client Onboarding (Roadmap Module 17,
// NOT built here) — never a duplicate opportunity record, never a
// duplicate money abstraction, never a real e-signature integration, never
// a customer-tenant/billing-subscription side effect. See
// docs/architecture/proposals-contracts.md.

/// The proposal ROOT — one per originating deal-quote lineage, never
/// mutated for commercial content (that lives on `CrmProposalVersion`).
/// Always originates from an existing `CrmDeal` (never a duplicate
/// opportunity record) and always inherits that deal's own `companyId`
/// (enforced by the relationship-integrity trigger). Multiple proposal
/// ROOTS may exist for one deal (e.g. two genuinely different proposals
/// offered in parallel); revisions to ONE proposal are versions of the
/// SAME root, never a new root — see `CrmProposalVersion`'s own comment.
model CrmProposal {
  id               String  @id @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  dealId           String  @map("deal_id") @db.Uuid
  companyId        String  @map("company_id") @db.Uuid
  /// Who internally the proposal is addressed to — optional (a proposal
  /// can exist before a specific contact is confirmed). Must belong to
  /// `companyId` (relationship-integrity trigger, the same
  /// "primary contact belongs to the same company" shape `CrmDeal`
  /// already establishes).
  primaryContactId String? @map("primary_contact_id") @db.Uuid

  /// Server-generated, unique, non-user-controlled — see
  /// `src/lib/crm/proposal-numbering.ts`'s own top comment (a real
  /// Postgres SEQUENCE, the same pattern `invoice-numbering.ts`
  /// established, never `MAX(number) + 1`).
  proposalNumber String @unique @map("proposal_number")

  /// The lifecycle authority — never inferred from version state alone.
  /// DRAFT -> SENT -> ACCEPTED | REJECTED | EXPIRED. SENT/REJECTED/
  /// EXPIRED may all "revise" back to DRAFT (a new version); ACCEPTED is
  /// the one true terminal state — see sales-pipeline.md's own
  /// CrmDeal.status precedent for "one column is the sole lifecycle
  /// authority, never bare related-row state."
  status CrmProposalStatus @default(DRAFT)

  /// The version currently in effect — while DRAFT, this is the one
  /// mutable version; once SENT, it's frozen and this pointer only ever
  /// advances to a NEW version (via `reviseProposal()`), never back.
  currentVersionId String? @unique @map("current_version_id") @db.Uuid

  /// The template this proposal started from, if any — provenance only;
  /// `SetNull` so archiving/deleting a template never breaks a
  /// historical proposal that started from it.
  templateId String? @map("template_id") @db.Uuid

  assignedToUserId String? @map("assigned_to_user_id") @db.Uuid

  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(3)
  expiredAt  DateTime? @map("expired_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal                 CrmDeal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company              CrmCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryContact       CrmContact?           @relation("CrmProposalPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  template             CrmProposalTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignedToUser       User?                 @relation("CrmProposalAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  currentVersion       CrmProposalVersion?   @relation("CrmProposalCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions             CrmProposalVersion[]  @relation("CrmProposalVersions")
  contracts            CrmContract[]
  /// Build 23 — onboarding engagements that used THIS proposal directly
  /// as their trigger (the no-contract-yet path — see
  /// `CrmClientOnboarding.originatingProposalId`'s own comment).
  onboardingsTriggered CrmClientOnboarding[] @relation("CrmClientOnboardingOriginatingProposal")

  /// Widened from a bare `[organizationId, dealId]` — flagged by the
  /// Build 22 performance review: `listForOrganization({ dealId })`
  /// orders `ORDER BY created_at DESC` after this filter, which the
  /// narrower index couldn't satisfy without an extra sort step.
  @@index([organizationId, dealId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([companyId, createdAt])
  /// Added — flagged by the Build 22 performance review: the unfiltered
  /// `listForOrganization({})` call (no status/dealId/companyId) orders
  /// by `created_at` with only `organizationId` in its own WHERE clause
  /// (RLS's own predicate), which none of the OTHER indexes above lead
  /// with `organizationId` alone before `createdAt` — `[organizationId,
  /// status, createdAt]` only helps once `status` is also present.
  @@index([organizationId, createdAt])
  /// Replaces the old `[assignedToUserId, status]` — flagged by the
  /// Build 22 performance review: that index didn't lead with
  /// `organizationId` (which RLS always adds to the effective WHERE
  /// clause for every query against this table), so it couldn't be used
  /// efficiently under the restricted role. This shape mirrors the
  /// pattern above.
  @@index([organizationId, assignedToUserId, createdAt])
  @@map("crm_proposals")
}

enum CrmProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("crm_proposal_status")
}

/// The immutable-once-sent commercial snapshot — title, body, line items,
/// totals, validity, approval, and acceptance state ALL live here, never
/// on the root, so historical proposals stay stable evidence even after
/// CRM data or later revisions change. COMMERCIAL fields (title/body/
/// terms/currency/pricing/validUntil) are frozen once `status <> DRAFT`
/// — enforced at the database boundary itself, by the relationship-
/// integrity trigger's own column-level `IS DISTINCT FROM` check (NOT
/// by RLS: RLS operates on whole rows and cannot cleanly express
/// "these columns frozen, those columns not," so the ordinary
/// tenant-scoped RLS UPDATE policy permits the row to be touched at
/// all, and the trigger is the actual precision guarantee). LIFECYCLE
/// fields (status, sent/approval/accepted/rejected timestamps and
/// actors) remain legitimately writable through their own state
/// machine after SENT — see `crm-proposal-version-repository.ts`'s own
/// `updateDraftContent()` vs. lifecycle-transition method split, and
/// the migration file's own NOTE comment for the full reasoning.
/// `reviseProposal()` creates a new row with `versionNumber + 1`, never
/// edits an existing SENT/ACCEPTED/REJECTED/EXPIRED row's commercial
/// content.
model CrmProposalVersion {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  proposalId     String @map("proposal_id") @db.Uuid

  /// 1-based, per-proposal — the human-readable "Version 2" a staff
  /// member sees; `proposalNumber` (on the root) is the stable external
  /// identifier, this is the internal revision counter.
  versionNumber Int @map("version_number")

  /// This version's OWN lifecycle marker — mirrors the root's `status`
  /// at the moment this version was current, frozen thereafter (a
  /// superseded version keeps whatever status it had when superseded,
  /// e.g. a version that was SENT and then revised stays `SENT` on its
  /// own row forever — the root's own `status` is what actually reflects
  /// the CURRENT state of the proposal as a whole).
  status CrmProposalStatus @default(DRAFT)

  title     String
  /// Sanitized server-side before storage — see
  /// `src/lib/crm/sanitize-proposal-html.ts`'s own top comment. Proposal
  /// content is customer-facing business content, handled as untrusted
  /// input regardless of who authored it.
  bodyHtml  String  @map("body_html")
  termsHtml String? @map("terms_html")

  /// ISO 4217 — one currency per version, applies to every line item
  /// (no mixed-currency proposals; same convention `CrmDeal.currency`
  /// already establishes).
  currency String @db.VarChar(3)

  /// Sum of line totals (after each line's own discount), before the
  /// proposal-level discount below. Integer minor units — never a float.
  subtotalMinorUnits           Int                     @map("subtotal_minor_units")
  discountType                 CrmProposalDiscountType @default(NONE) @map("discount_type")
  /// Minor units for FIXED, integer 0-100 for PERCENT, null for NONE —
  /// same exactly-one-of-value-matches-kind discipline
  /// `CrmSalesGoal`'s own CHECK constraint already established.
  discountValue                Int?                    @map("discount_value")
  /// subtotal - the resolved discount amount. Never negative (CHECK).
  discountedSubtotalMinorUnits Int                     @map("discounted_subtotal_minor_units")
  /// Manually entered/externally supplied — NEVER computed. `null`
  /// means "tax not entered," rendered as "Tax not calculated," a
  /// genuinely different state from an entered `0`. See
  /// proposals-contracts.md "Tax boundary."
  taxAmountMinorUnits          Int?                    @map("tax_amount_minor_units")
  /// discountedSubtotal + (taxAmount ?? 0) — the one number a customer
  /// actually owes if they accept.
  totalMinorUnits              Int                     @map("total_minor_units")

  /// How long this quote is valid for — `acceptProposal()` refuses an
  /// attempt after this instant, regardless of the root's own `status`.
  validUntil DateTime @map("valid_until") @db.Timestamptz(3)

  /// NOT_REQUIRED unless a real approval step was actually requested for
  /// THIS version — see proposals-contracts.md "Approval boundary vs
  /// Module 67." `sendProposal()` refuses unless this is NOT_REQUIRED or
  /// APPROVED.
  approvalStatus            CrmProposalApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  approvalSubmittedByUserId String?                   @map("approval_submitted_by_user_id") @db.Uuid
  approvalSubmittedAt       DateTime?                 @map("approval_submitted_at") @db.Timestamptz(3)
  /// The approver — deliberately NEVER equal to
  /// `approvalSubmittedByUserId` (self-approval is prohibited, enforced
  /// server-side — see proposals-contracts.md).
  approvalDecidedByUserId   String?                   @map("approval_decided_by_user_id") @db.Uuid
  approvalDecidedAt         DateTime?                 @map("approval_decided_at") @db.Timestamptz(3)
  approvalNote              String?                   @map("approval_note")

  sentAt       DateTime? @map("sent_at") @db.Timestamptz(3)
  sentByUserId String?   @map("sent_by_user_id") @db.Uuid

  /// Acceptance is always `INTERNAL_RECORDED` in Build 22 — a staff
  /// member honestly recording a real verbal/email/in-person acceptance,
  /// never an external self-service action. `signature*` fields below
  /// are separate, deliberately unused readiness columns — see
  /// proposals-contracts.md "E-signature readiness."
  acceptedAt            DateTime?                       @map("accepted_at") @db.Timestamptz(3)
  acceptedByContactId   String?                         @map("accepted_by_contact_id") @db.Uuid
  /// Snapshots — the ACTUAL typed name/email at acceptance, which may
  /// legitimately differ from `acceptedByContactId`'s own current CRM
  /// record (a different real-world signer, or the contact's own email
  /// changing later). Never silently re-derived from the contact record.
  acceptedSignerName    String?                         @map("accepted_signer_name")
  acceptedSignerEmail   String?                         @map("accepted_signer_email")
  acceptedByStaffUserId String?                         @map("accepted_by_staff_user_id") @db.Uuid
  acceptanceMechanism   CrmProposalAcceptanceMechanism? @map("acceptance_mechanism")

  /// Readiness-only — Build 22 never sets these beyond their own
  /// defaults; a real future e-signature integration (its own dedicated
  /// task, not this build) would populate them. Never claim a signature
  /// happened that didn't.
  signatureProvider   String?                    @map("signature_provider")
  signatureEnvelopeId String?                    @map("signature_envelope_id")
  signatureStatus     CrmProposalSignatureStatus @default(NONE) @map("signature_status")

  rejectedAt     DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectedReason String?   @map("rejected_reason")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal                CrmProposal           @relation("CrmProposalVersions", fields: [proposalId], references: [id], onDelete: Cascade)
  currentForProposal      CrmProposal?          @relation("CrmProposalCurrentVersion")
  approvalSubmittedByUser User?                 @relation("CrmProposalVersionApprovalSubmittedBy", fields: [approvalSubmittedByUserId], references: [id], onDelete: SetNull)
  approvalDecidedByUser   User?                 @relation("CrmProposalVersionApprovalDecidedBy", fields: [approvalDecidedByUserId], references: [id], onDelete: SetNull)
  sentByUser              User?                 @relation("CrmProposalVersionSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  acceptedByContact       CrmContact?           @relation("CrmProposalVersionAcceptedByContact", fields: [acceptedByContactId], references: [id], onDelete: SetNull)
  acceptedByStaffUser     User?                 @relation("CrmProposalVersionAcceptedByStaff", fields: [acceptedByStaffUserId], references: [id], onDelete: SetNull)
  createdByUser           User                  @relation("CrmProposalVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lineItems               CrmProposalLineItem[]
  contracts               CrmContract[]

  @@unique([proposalId, versionNumber])
  @@index([organizationId, proposalId])
  @@map("crm_proposal_versions")
}

enum CrmProposalDiscountType {
  NONE
  FIXED
  PERCENT

  @@map("crm_proposal_discount_type")
}

enum CrmProposalApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED

  @@map("crm_proposal_approval_status")
}

enum CrmProposalAcceptanceMechanism {
  /// The only mechanism Build 22 implements — a platform-staff member
  /// honestly recording a real acceptance obtained outside Alpha OS
  /// (verbal, email, in-person). Never conflated with a cryptographic
  /// digital signature.
  INTERNAL_RECORDED

  @@map("crm_proposal_acceptance_mechanism")
}

enum CrmProposalSignatureStatus {
  /// The only value Build 22 ever actually sets. PENDING/COMPLETED are
  /// reserved for a real future e-signature integration — never faked.
  NONE
  PENDING
  COMPLETED

  @@map("crm_proposal_signature_status")
}

/// One priced line within one proposal version — a commercial SNAPSHOT,
/// not a live reference (Roadmap Module 23, Service Management, doesn't
/// exist yet). `title`/`description` are what make this snapshot durable
/// on their own; a future `serviceId` FK can be added by Module 23
/// without rewriting any historical proposal.
model CrmProposalLineItem {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  versionId      String @map("version_id") @db.Uuid

  title                String
  description          String?
  quantity             Int     @default(1)
  /// Integer minor units.
  unitAmountMinorUnits Int     @map("unit_amount_minor_units")

  discountType        CrmProposalDiscountType @default(NONE) @map("discount_type")
  /// Minor units for FIXED, integer 0-100 for PERCENT, null for NONE.
  discountValue       Int?                    @map("discount_value")
  /// (quantity × unitAmountMinorUnits) minus this line's own resolved
  /// discount. Never negative (CHECK).
  lineTotalMinorUnits Int                     @map("line_total_minor_units")

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization           Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version                CrmProposalVersion               @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// Build 23 — onboarding service-item snapshots that trace their own
  /// provenance back to this line item (`SetNull` on delete, provenance
  /// only — see `CrmClientOnboardingServiceItem`'s own comment).
  onboardingServiceItems CrmClientOnboardingServiceItem[]

  @@index([organizationId, versionId, sortOrder])
  @@map("crm_proposal_line_items")
}

/// Tenant-owned, RLS-protected starting content for a new proposal —
/// title/body/terms/default validity only, deliberately NOT a global
/// template CMS and NOT a document-management system (Roadmap Module 16
/// scope, not 45/64). No template-level line items — line items are
/// added per-proposal; a template is a content convenience, not a
/// structural requirement.
model CrmProposalTemplate {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name                String
  defaultTitle        String  @map("default_title")
  /// Sanitized server-side before storage — same discipline as
  /// `CrmProposalVersion.bodyHtml`.
  defaultBodyHtml     String  @map("default_body_html")
  defaultTermsHtml    String? @map("default_terms_html")
  defaultValidityDays Int     @default(30) @map("default_validity_days")

  status CrmProposalTemplateStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals    CrmProposal[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("crm_proposal_templates")
}

enum CrmProposalTemplateStatus {
  ACTIVE
  ARCHIVED

  @@map("crm_proposal_template_status")
}

/// The commercial agreement resulting from an accepted proposal, OR a
/// manually recorded agreement where justified (both explicitly
/// permitted — see proposals-contracts.md). Deliberately NOT a document-
/// management system: no file storage, no attachment versioning — the
/// accepted `CrmProposalVersion` (when present) already IS the durable
/// commercial/legal snapshot; this model does not re-copy its content.
model CrmContract {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  dealId         String @map("deal_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid

  /// Both null together (manually recorded agreement) or both set
  /// together (originated from an accepted proposal) — validated at the
  /// service layer; the relationship-integrity trigger additionally
  /// requires, when set, that the referenced version actually belongs to
  /// `originatingProposalId` and is ACCEPTED.
  originatingProposalId        String? @map("originating_proposal_id") @db.Uuid
  originatingProposalVersionId String? @map("originating_proposal_version_id") @db.Uuid

  /// Server-generated — reuses the SAME numbering pattern as proposals
  /// (`src/lib/crm/contract-numbering.ts`, its own dedicated sequence),
  /// never the proposal's own number reused as the contract's identifier.
  contractNumber String @unique @map("contract_number")

  status CrmContractStatus @default(DRAFT)

  effectiveDate DateTime? @map("effective_date") @db.Timestamptz(3)
  endDate       DateTime? @map("end_date") @db.Timestamptz(3)
  /// Free-text summary only — e.g. "auto-renews annually unless 30 days'
  /// notice." Not a structured renewal engine (out of Build 22's own
  /// scope).
  renewalTerms  String?   @map("renewal_terms")

  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(3)
  terminatedAt     DateTime? @map("terminated_at") @db.Timestamptz(3)
  terminatedReason String?   @map("terminated_reason")
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal                       CrmDeal                   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company                    CrmCompany                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originatingProposal        CrmProposal?              @relation(fields: [originatingProposalId], references: [id], onDelete: SetNull)
  originatingProposalVersion CrmProposalVersion?       @relation(fields: [originatingProposalVersionId], references: [id], onDelete: SetNull)
  createdByUser              User                      @relation("CrmContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// Build 23 — onboarding engagements triggered by THIS contract (the
  /// common, preferred path — see `CrmClientOnboarding.originatingContractId`'s
  /// own comment).
  onboardingsTriggered       CrmClientOnboarding[]     @relation("CrmClientOnboardingOriginatingContract")
  /// Build 25 — renewal records tracking THIS contract's own decision.
  clientSuccessRenewals      CrmClientSuccessRenewal[]

  /// Widened, and the unfiltered index added below — same reasoning as
  /// `CrmProposal`'s own identical Build 22 performance-review fix.
  @@index([organizationId, dealId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([companyId, createdAt])
  @@index([organizationId, createdAt])
  /// Added post-Build 25 review (Codex Performance Engineer): Client
  /// Success's own "active contracts expiring soon" portfolio query
  /// filters/sorts by `endDate`, which none of the indexes above lead
  /// with after `status` — a genuinely new access pattern this table
  /// didn't have before, not a re-audit of Build 22's own existing
  /// queries (none of which use `endDate` this way).
  @@index([organizationId, status, endDate])
  @@map("crm_contracts")
}

enum CrmContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED

  @@map("crm_contract_status")
}

// =============================================================================
// Build 23 — Client Onboarding (Canonical Roadmap Module 17)
// =============================================================================
// Converts a WON deal (with an ACCEPTED proposal and/or ACTIVE contract) into
// an operational onboarding engagement. See docs/architecture/client-onboarding.md
// for the full design — summarized here at each model's own point of use.
//
// Tenant ownership: every table below is owned by the PLATFORM organization
// (`organizationId`), exactly like every CRM table since Build 19 — this is
// Alpha OS's own internal record OF an onboarding engagement, not the
// customer organization's own tenant data. The customer's own `Organization`
// (`CrmClientOnboarding.linkedOrganizationId`) is a separate, linked row this
// domain never writes application data into.

/// The onboarding aggregate root. One row per onboarding ENGAGEMENT — a
/// cancelled engagement is never resurrected; retrying creates a brand-new
/// row (mirrors `CrmSalesTeamMember`'s own "rejoin gets a new row, not a
/// reactivated one" precedent), which is exactly why `dealId` is NOT simply
/// `@unique` — the partial unique index below (hand-added in the migration;
/// Prisma cannot express a `WHERE` clause in `@@unique`) allows any number of
/// historical CANCELLED rows per deal, but at most one non-cancelled row.
model CrmClientOnboarding {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  dealId    String @map("deal_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// The customer's own `Organization` — reused via `CrmCompany.
  /// convertedToOrganizationId` if the company already converted, or newly
  /// created by THIS onboarding's own conversion transaction otherwise.
  /// Required, not nullable: the conversion step always runs BEFORE this
  /// row is created (see `convertDealToClient()`'s own transaction
  /// ordering) — there is no "onboarding exists but has no linked
  /// organization yet" state.
  linkedOrganizationId String @map("linked_organization_id") @db.Uuid

  /// Trigger provenance — at least one of these two must be set (CHECK
  /// constraint in the migration, mirroring `CrmContract`'s own origin-pair
  /// discipline). `originatingContractId` is the preferred/common path
  /// (the actual signed agreement); `originatingProposalId` covers the
  /// legitimate case where a deal was WON and its proposal ACCEPTED before
  /// any contract was ever created (Build 22 never requires one). Both may
  /// be set together (the common case: a contract that itself originated
  /// from this same proposal) — stored directly rather than derived
  /// transitively through the contract's own `originatingProposalId`, the
  /// same "store the direct reference" discipline Build 22's own
  /// `CrmContract` establishes.
  originatingContractId String? @map("originating_contract_id") @db.Uuid
  originatingProposalId String? @map("originating_proposal_id") @db.Uuid

  status CrmClientOnboardingStatus @default(NOT_STARTED)

  kickoffScheduledAt DateTime? @map("kickoff_scheduled_at") @db.Timestamptz(3)
  kickoffCompletedAt DateTime? @map("kickoff_completed_at") @db.Timestamptz(3)
  /// Internal record only — never a real calendar invite. See
  /// client-onboarding.md "Kickoff."
  kickoffNotes       String?   @map("kickoff_notes")
  kickoffOwnerUserId String?   @map("kickoff_owner_user_id") @db.Uuid

  /// Terminal — CAS-guarded from any non-terminal status.
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledReason   String?   @map("cancelled_reason")
  cancelledByUserId String?   @map("cancelled_by_user_id") @db.Uuid

  /// Terminal — server-calculated from completion criteria UNLESS
  /// `completionOverride` is true, in which case a privileged actor forced
  /// completion despite incomplete required work — `completionOverrideReason`
  /// is required whenever `completionOverride` is true (CHECK in the
  /// migration), and this action is separately audited
  /// (`crm.onboarding.completed_override`) from an ordinary criteria-met
  /// completion (`crm.onboarding.completed`).
  completedAt              DateTime? @map("completed_at") @db.Timestamptz(3)
  completedByUserId        String?   @map("completed_by_user_id") @db.Uuid
  completionOverride       Boolean   @default(false) @map("completion_override")
  completionOverrideReason String?   @map("completion_override_reason")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization                        @relation("CrmClientOnboardingPlatformOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  deal                CrmDeal                             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company             CrmCompany                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  linkedOrganization  Organization                        @relation("CrmClientOnboardingLinkedOrganization", fields: [linkedOrganizationId], references: [id], onDelete: Cascade)
  originatingContract CrmContract?                        @relation("CrmClientOnboardingOriginatingContract", fields: [originatingContractId], references: [id], onDelete: SetNull)
  originatingProposal CrmProposal?                        @relation("CrmClientOnboardingOriginatingProposal", fields: [originatingProposalId], references: [id], onDelete: SetNull)
  kickoffOwnerUser    User?                               @relation("CrmClientOnboardingKickoffOwner", fields: [kickoffOwnerUserId], references: [id], onDelete: SetNull)
  cancelledByUser     User?                               @relation("CrmClientOnboardingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  completedByUser     User?                               @relation("CrmClientOnboardingCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdByUser       User                                @relation("CrmClientOnboardingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  serviceItems        CrmClientOnboardingServiceItem[]
  intakeResponses     CrmClientOnboardingIntakeResponse[]
  requirements        CrmClientOnboardingRequirement[]
  checklistItems      CrmClientOnboardingChecklistItem[]
  documents           CrmClientOnboardingDocument[]
  assignments         CrmClientOnboardingAssignment[]

  @@index([organizationId, dealId])
  @@index([organizationId, status, createdAt])
  // The default (unfiltered) `listForOrganization()` call orders by
  // `createdAt DESC` alone — the `(organizationId, status, createdAt)`
  // index above can't serve that ordering when `status` isn't part of the
  // WHERE clause (Codex Performance Engineer review). This is the plain
  // "list everything for this tenant, newest first" index every other
  // CRM list repository has its own equivalent of.
  @@index([organizationId, createdAt])
  @@index([companyId, createdAt])
  @@index([organizationId, linkedOrganizationId])
  @@map("crm_client_onboardings")
}

enum CrmClientOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED

  @@map("crm_client_onboarding_status")
}

/// A snapshot of ONE sold service line for onboarding/operational purposes
/// — never a live reference into the accepted proposal version (which stays
/// immutable) and never the future canonical Service Management catalog
/// (Roadmap Module 23, which doesn't exist yet). `sourceLineItemId` is
/// provenance only (`SetNull` — a historical onboarding record must never
/// break if the source line item's own row is ever affected).
model CrmClientOnboardingServiceItem {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  onboardingId   String @map("onboarding_id") @db.Uuid

  title              String
  description        String?
  quantity           Int     @default(1)
  sourceLineItemId   String? @map("source_line_item_id") @db.Uuid
  /// Whether THIS service genuinely needs its own onboarding attention
  /// (vs. a line item that's purely commercial, e.g. a one-time discount
  /// line) — an onboarding-only operational flag, never written back to
  /// the commercial snapshot.
  onboardingRequired Boolean @default(true) @map("onboarding_required")
  notes              String?
  sortOrder          Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboarding     CrmClientOnboarding  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  sourceLineItem CrmProposalLineItem? @relation(fields: [sourceLineItemId], references: [id], onDelete: SetNull)

  @@index([organizationId, onboardingId, sortOrder])
  @@map("crm_client_onboarding_service_items")
}

/// Tenant-wide, reusable intake field CATALOG — deliberately NOT a generic
/// Forms Builder (no arbitrary/executable schema): a small, fixed set of
/// justified field types, defined once per organization and reused across
/// every onboarding, the same "tenant-owned reusable content" shape
/// `CrmProposalTemplate` already establishes. Archiving (not deleting) is
/// the retirement path, same reasoning as that model.
model CrmClientOnboardingIntakeField {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  label     String
  fieldType CrmClientOnboardingIntakeFieldType   @map("field_type")
  required  Boolean                              @default(true)
  /// SELECT choices only — `null` for every other field type (CHECK in
  /// the migration). A flat string array, not a structured options
  /// schema — deliberately minimal.
  options   Json?
  sortOrder Int                                  @default(0) @map("sort_order")
  status    CrmClientOnboardingIntakeFieldStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responses    CrmClientOnboardingIntakeResponse[]

  @@unique([organizationId, label])
  @@index([organizationId, status, sortOrder])
  @@map("crm_client_onboarding_intake_fields")
}

enum CrmClientOnboardingIntakeFieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  URL
  SELECT
  CHECKBOX
  DATE

  @@map("crm_client_onboarding_intake_field_type")
}

enum CrmClientOnboardingIntakeFieldStatus {
  ACTIVE
  ARCHIVED

  @@map("crm_client_onboarding_intake_field_status")
}

/// One response per field per onboarding — staff-recorded only in Build 23
/// (no customer self-service intake surface exists yet). Stored as a plain
/// string regardless of field type (CHECKBOX as `"true"`/`"false"`, DATE as
/// an ISO date string) — type-specific validation happens at the service
/// layer against the field's own `fieldType`, matching the discipline
/// `proposal-pricing.ts` already established for "validate structurally at
/// the application layer, keep the storage shape simple."
model CrmClientOnboardingIntakeResponse {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  onboardingId   String @map("onboarding_id") @db.Uuid
  fieldId        String @map("field_id") @db.Uuid

  value             String?
  respondedByUserId String?   @map("responded_by_user_id") @db.Uuid
  respondedAt       DateTime? @map("responded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboarding      CrmClientOnboarding            @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  field           CrmClientOnboardingIntakeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  respondedByUser User?                          @relation("CrmClientOnboardingIntakeResponseRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  @@unique([onboardingId, fieldId])
  @@index([organizationId, onboardingId])
  @@map("crm_client_onboarding_intake_responses")
}

/// Information/assets/actions needed before delivery — NOT global Task
/// Management, onboarding-scoped only. `documentId` links to the actual
/// evidence once received (see `CrmClientOnboardingDocument`).
model CrmClientOnboardingRequirement {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  onboardingId   String @map("onboarding_id") @db.Uuid

  title             String
  description       String?
  required          Boolean                              @default(true)
  status            CrmClientOnboardingRequirementStatus @default(PENDING)
  responsibleUserId String?                              @map("responsible_user_id") @db.Uuid
  dueDate           DateTime?                            @map("due_date") @db.Timestamptz(3)
  completedAt       DateTime?                            @map("completed_at") @db.Timestamptz(3)
  documentId        String?                              @map("document_id") @db.Uuid
  sortOrder         Int                                  @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboarding      CrmClientOnboarding          @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  responsibleUser User?                        @relation("CrmClientOnboardingRequirementResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  document        CrmClientOnboardingDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  /// Explicit `map` names — the auto-generated names for these two indexes
  /// truncate (Postgres's 63-byte identifier limit) to the same string,
  /// which `prisma validate` correctly rejects as a collision.
  @@index([organizationId, onboardingId, sortOrder], map: "crm_onboarding_requirements_org_onboarding_sort_idx")
  @@index([organizationId, onboardingId, status], map: "crm_onboarding_requirements_org_onboarding_status_idx")
  @@map("crm_client_onboarding_requirements")
}

enum CrmClientOnboardingRequirementStatus {
  PENDING
  IN_PROGRESS
  COMPLETE

  @@map("crm_client_onboarding_requirement_status")
}

/// Onboarding-scoped document/file REFERENCE only — metadata, never a real
/// upload. `storage.ts` (Roadmap Module 56) is still unconfigured (every
/// `StorageProvider` method throws `StorageNotConfiguredError` — confirmed
/// live during this build's own reconnaissance, same finding Build 22's own
/// PDF-generation section documents), so `fileKey` stays `null` throughout
/// Build 23 — ready for Module 56 to populate later, never faked now. Staff
/// may only RECORD that a document was requested/received (with an
/// optional external reference note), never upload one through this build.
model CrmClientOnboardingDocument {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  onboardingId   String @map("onboarding_id") @db.Uuid

  title        String
  description  String?
  status       CrmClientOnboardingDocumentStatus @default(REQUESTED)
  /// A real `StorageProvider` key once Module 56 exists — always `null`
  /// in Build 23.
  fileKey      String?                           @map("file_key")
  /// Free-text note on how the document was actually received (e.g. "via
  /// email, filed externally") — honest about the absence of real upload,
  /// never a fabricated delivery claim.
  receivedNote String?                           @map("received_note")
  receivedAt   DateTime?                         @map("received_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboarding   CrmClientOnboarding              @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  requirements CrmClientOnboardingRequirement[]

  @@index([organizationId, onboardingId])
  @@map("crm_client_onboarding_documents")
}

enum CrmClientOnboardingDocumentStatus {
  REQUESTED
  RECEIVED

  @@map("crm_client_onboarding_document_status")
}

/// Onboarding-scoped checklist — NOT the future global Task Management
/// system. No dependency graph (not genuinely required for Build 23's own
/// scope). Completion is idempotent/race-safe via a CAS `updateMany()` at
/// the repository layer (guarded on `status <> 'COMPLETE'`), never a bare
/// `update()`.
model CrmClientOnboardingChecklistItem {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  onboardingId   String @map("onboarding_id") @db.Uuid

  title            String
  description      String?
  sortOrder        Int                                    @default(0) @map("sort_order")
  status           CrmClientOnboardingChecklistItemStatus @default(PENDING)
  required         Boolean                                @default(true)
  assignedToUserId String?                                @map("assigned_to_user_id") @db.Uuid
  dueDate          DateTime?                              @map("due_date") @db.Timestamptz(3)
  completedAt      DateTime?                              @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboarding     CrmClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  assignedToUser User?               @relation("CrmClientOnboardingChecklistAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  /// Explicit `map` names — same truncation collision as
  /// `CrmClientOnboardingRequirement`'s own identical pair above.
  @@index([organizationId, onboardingId, sortOrder], map: "crm_onboarding_checklist_items_org_onboarding_sort_idx")
  @@index([organizationId, onboardingId, status], map: "crm_onboarding_checklist_items_org_onboarding_status_idx")
  @@map("crm_client_onboarding_checklist_items")
}

enum CrmClientOnboardingChecklistItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETE

  @@map("crm_client_onboarding_checklist_item_status")
}

/// Internal staff assigned to an onboarding role — reuses Build 21's own
/// `assertPlatformStaffMember` validation (inactive/suspended/deactivated
/// users cannot become new assignees) at the service layer; the DB layer
/// only enforces "at most one person per role per onboarding" (unique
/// below), the same "app-layer identity validation, DB-layer shape
/// validation" split every other CRM assignee FK in this project already
/// uses (`CrmDeal.assignedToUserId`, `CrmProposal.assignedToUserId`, ...).
model CrmClientOnboardingAssignment {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  onboardingId   String @map("onboarding_id") @db.Uuid

  userId           String                            @map("user_id") @db.Uuid
  role             CrmClientOnboardingAssignmentRole
  assignedByUserId String                            @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime                          @default(now()) @map("assigned_at") @db.Timestamptz(3)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  onboarding     CrmClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  user           User                @relation("CrmClientOnboardingAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User                @relation("CrmClientOnboardingAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@unique([onboardingId, role])
  @@index([organizationId, userId])
  @@map("crm_client_onboarding_assignments")
}

enum CrmClientOnboardingAssignmentRole {
  ACCOUNT_MANAGER
  ONBOARDING_OWNER
  SERVICE_LEAD

  @@map("crm_client_onboarding_assignment_role")
}

// =============================================================================
// Build 25 — Client Success (Canonical Roadmap Module 19)
// =============================================================================
//
// Health/risk/engagement are all computed LIVE at read time in
// `src/lib/crm/client-success.ts` + `client-success-service.ts` — never
// persisted (see client-success.md "Persistence"). The three models
// below are the only genuinely new, non-derivable state this module
// introduces: who owns Client Success for a customer, and the two real
// lifecycle workflows (renewal, expansion) that have no other source of
// truth. All three are platform-organization-owned (organizationId is
// ALWAYS the platform org, mirroring every other `crm_*` table — see
// `crm-shared.ts`'s own "CRM is Alpha Page Rankers' own internal sales
// tool" comment) and, like every Build 23 table, deliberately designed
// so DELETE is never needed (upsert/CAS-only) — the same discipline that
// avoided Build 22's own DELETE/RLS bug class.

/// One row per `CrmCompany` that Client Success has ever touched —
/// created lazily (on first CS-owner assignment or first management-
/// attention flag), never eagerly for every company. Holds exactly the
/// two things that are genuinely NEW facts, not derivable from any
/// existing domain: who owns Client Success for this customer, and the
/// one manual signal this build allows (a management-attention flag,
/// deliberately NOT a numeric health override — see client-success.md
/// "Manual overrides").
model CrmClientSuccessProfile {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  companyId      String @unique @map("company_id") @db.Uuid

  /// Reuses the existing platform `User` — no second Employee/CS-owner
  /// table. Deliberately independent of Build 23's own onboarding
  /// `ACCOUNT_MANAGER` assignment — the sales/onboarding owner is not
  /// assumed to remain the Client Success owner (see client-success.md
  /// "CS ownership").
  csOwnerUserId String? @map("cs_owner_user_id") @db.Uuid

  /// A flag, not a score override (spec's own explicit "avoid arbitrary
  /// manual health-score overrides" instruction) — a human saying "pay
  /// attention to this account," always shown ALONGSIDE the computed
  /// health, never blended into it. `managementAttentionReason` is
  /// required whenever the flag is true (CHECK in the migration, the
  /// same "reason required" discipline
  /// `crm_client_onboardings_completion_override_reason_required_check`
  /// already established in Build 23).
  managementAttentionFlag        Boolean   @default(false) @map("management_attention_flag")
  managementAttentionReason      String?   @map("management_attention_reason")
  managementAttentionSetByUserId String?   @map("management_attention_set_by_user_id") @db.Uuid
  managementAttentionSetAt       DateTime? @map("management_attention_set_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company                      CrmCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  csOwnerUser                  User?        @relation("CrmClientSuccessProfileOwner", fields: [csOwnerUserId], references: [id], onDelete: SetNull)
  managementAttentionSetByUser User?        @relation("CrmClientSuccessProfileAttentionSetBy", fields: [managementAttentionSetByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, csOwnerUserId])
  @@map("crm_client_success_profiles")
}

/// A tracked renewal decision for one real `CrmContract` — never a
/// fabricated date; `renewalDate` is pre-filled from the contract's own
/// `endDate` when created and stays staff-editable afterward (a
/// contract's free-text `renewalTerms`, e.g. "auto-renews annually,"
/// means the real decision date can legitimately differ from the raw
/// `endDate`), but `contractId` permanently preserves the real source.
/// At most one non-terminal renewal may exist per contract (partial
/// unique index in the migration, mirroring Build 23's own "one active
/// onboarding per deal").
model CrmClientSuccessRenewal {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  contractId     String @map("contract_id") @db.Uuid

  renewalDate DateTime                      @map("renewal_date") @db.Timestamptz(3)
  status      CrmClientSuccessRenewalStatus @default(UPCOMING)
  ownerUserId String?                       @map("owner_user_id") @db.Uuid

  /// Only ever staff-entered (never inferred/copied automatically — see
  /// client-success.md "Renewal tracking"). Both null together or both
  /// set together (CHECK in the migration, the same "currency only
  /// alongside a real amount" pattern every other minor-units field in
  /// this schema follows).
  expectedValueMinorUnits Int?    @map("expected_value_minor_units")
  expectedValueCurrency   String? @map("expected_value_currency")

  notes String?

  /// Required once `status` reaches a terminal value (CHECK in the
  /// migration) — the same "reason required at the terminal transition"
  /// discipline `CrmClientOnboarding.completionOverrideReason` already
  /// established.
  outcome String?

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       CrmCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract      CrmContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  ownerUser     User?        @relation("CrmClientSuccessRenewalOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdByUser User         @relation("CrmClientSuccessRenewalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, companyId, renewalDate])
  @@index([organizationId, status, renewalDate])
  @@index([contractId])
  @@map("crm_client_success_renewals")
}

enum CrmClientSuccessRenewalStatus {
  UPCOMING
  IN_PROGRESS
  RENEWED
  NOT_RENEWING
  EXPIRED

  @@map("crm_client_success_renewal_status")
}

/// A Client-Success-identified growth signal — deliberately NOT a
/// second Sales Pipeline: no stage/probability/forecast, just a title,
/// a REQUIRED rationale (the "why," not just a label), and an optional
/// staff-entered estimate. `handedToDealId` links to an EXISTING
/// `CrmDeal` a staff member explicitly chose — this module never auto-
/// creates a Deal (spec's own explicit instruction).
model CrmClientSuccessExpansionOpportunity {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid

  title     String
  rationale String
  status    CrmClientSuccessExpansionStatus @default(IDENTIFIED)

  /// Only ever staff-entered — never derived (spec: "estimated value
  /// only if manually/authoritatively entered"). Both null together or
  /// both set together (CHECK in the migration).
  estimatedValueMinorUnits Int?    @map("estimated_value_minor_units")
  estimatedValueCurrency   String? @map("estimated_value_currency")

  /// Free text — where the signal actually came from (e.g. "renewal
  /// conversation," "upsell request via email"). No automatic signal
  /// detection exists yet, so this is honestly staff-entered, never a
  /// fabricated category.
  sourceSignal String? @map("source_signal")
  notes        String?

  ownerUserId String? @map("owner_user_id") @db.Uuid

  /// Set only once genuinely handed to Sales — a controlled, explicit
  /// link to an EXISTING deal the staff member picked (relationship-
  /// integrity trigger requires it belong to the same `companyId` when
  /// set). Nullable even after `HANDED_TO_SALES` — the hand-off itself
  /// and the deal link are two separate, independently-timed actions.
  handedToDealId String? @map("handed_to_deal_id") @db.Uuid

  identifiedAt DateTime @default(now()) @map("identified_at") @db.Timestamptz(3)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       CrmCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerUser     User?        @relation("CrmClientSuccessExpansionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  handedToDeal  CrmDeal?     @relation("CrmClientSuccessExpansionHandedToDeal", fields: [handedToDealId], references: [id], onDelete: SetNull)
  createdByUser User         @relation("CrmClientSuccessExpansionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Explicit `map` names — the auto-generated names for these two
  /// indexes truncate (Postgres's 63-byte identifier limit) to the same
  /// string, the same collision Build 23's own `CrmClientOnboardingRequirement`/
  /// `CrmClientOnboardingChecklistItem` indexes already hit.
  @@index([organizationId, companyId, status], map: "crm_client_success_expansion_org_company_status_idx")
  @@index([organizationId, status, identifiedAt], map: "crm_client_success_expansion_org_status_identified_idx")
  @@map("crm_client_success_expansion_opportunities")
}

enum CrmClientSuccessExpansionStatus {
  IDENTIFIED
  QUALIFIED
  HANDED_TO_SALES
  DISMISSED

  @@map("crm_client_success_expansion_status")
}
